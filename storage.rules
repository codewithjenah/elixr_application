rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfileImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    // Authenticated users may view any profile avatar (shown across the
    // app in the sidebar, profile menu, and profile settings). Only the
    // owning UID may create, replace, or delete files under their own
    // profile path.
    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidProfileImage();
      allow delete: if isOwner(userId);
    }

    // No other paths are provisioned; deny by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
