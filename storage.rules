rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Learning-material reads intentionally use a bounded server-owned
    // projection plus its generation gate. Do not replace this with assignment
    // + membership + recipient checks: that chain exceeds the safe Storage-rule
    // lookup budget for targeted Activities.
    function materialAccessPath(assignmentId, materialId, userId) {
      return /databases/(default)/documents/activity_material_access/$(assignmentId + '__' + materialId + '__' + userId);
    }

    function materialMetadataPath(assignmentId, materialId) {
      return /databases/(default)/documents/group_assignments/$(assignmentId)/learning_materials/$(materialId);
    }

    function hasActivityMaterialAccess(assignmentId, materialId) {
      let access = firestore.get(materialAccessPath(
        assignmentId, materialId, request.auth.uid
      )).data;
      let state = firestore.get(
        /databases/(default)/documents/activity_material_access_state/$(assignmentId)
      ).data;
      let material = firestore.get(materialMetadataPath(assignmentId, materialId)).data;
      return isSignedIn()
        && access.assignment_id == assignmentId
        && access.material_id == materialId
        && access.user_id == request.auth.uid
        && access.projection_generation == state.generation
        && state.assignment_id == assignmentId
        && state.state == 'ready'
        && state.schema_version == 1
        && access.schema_version == 1
        // A deletion state is a second, authoritative fail-closed guard
        // against a projection rebuild that began before removal.
        && material.assignment_id == assignmentId
        && material.material_id == materialId
        && material.status == 'ready';
    }

    function stagingUploadPath(teacherId, assignmentId, uploadId) {
      return /databases/(default)/documents/activity_material_uploads/$(uploadId);
    }

    function canCreateActivityMaterialStaging(teacherId, assignmentId, uploadId) {
      let stage = firestore.get(stagingUploadPath(teacherId, assignmentId, uploadId)).data;
      return isOwner(teacherId)
        && stage.schema_version == 1
        && stage.state == 'staging'
        && stage.upload_id == uploadId
        && stage.assignment_id == assignmentId
        && stage.owner_teacher_id == teacherId
        && stage.staging_path == 'activity_material_staging/' + teacherId + '/' + assignmentId + '/' + uploadId
        && stage.expires_at is timestamp
        && request.time < stage.expires_at
        && stage.declared_size_bytes is int
        && stage.declared_size_bytes > 0
        && request.resource.size == stage.declared_size_bytes
        && request.resource.contentType == stage.declared_content_type
        && (request.resource.metadata == null || request.resource.metadata.size() == 0);
    }

    function sessionEvidenceEnabled(traineeId) {
      let user = /databases/(default)/documents/users/$(traineeId);
      return firestore.exists(user)
        && firestore.get(user).data.get('session_evidence_enabled', false) == true;
    }

    function hasTeacherEvidenceGrant(traineeId) {
      let link = /databases/(default)/documents/teacher_student_links/$(request.auth.uid + '_' + traineeId);
      return isSignedIn()
        && firestore.exists(link)
        && firestore.get(link).data.teacher_id == request.auth.uid
        && firestore.get(link).data.trainee_id == traineeId
        && firestore.get(link).data.status == 'approved'
        && firestore.get(link).data.progress_access == 'granted'
        && firestore.get(link).data.progress_access_version == 1
        && firestore.get(link).data.progress_access_granted_at is timestamp
        && firestore.get(link).data.evidence_access == 'granted'
        && firestore.get(link).data.evidence_access_version == 1
        && firestore.get(link).data.evidence_access_granted_at is timestamp
        && sessionEvidenceEnabled(traineeId);
    }

    function hasTeacherClassroomEvidenceGrant(traineeId) {
      let contextRef = /databases/(default)/documents/classroom_teacher_access/$(request.auth.uid + '_' + traineeId);
      return isSignedIn()
        && firestore.exists(contextRef)
        && firestore.get(contextRef).data.get('teacher_id', '') == request.auth.uid
        && firestore.get(contextRef).data.get('trainee_id', '') == traineeId
        && firestore.get(contextRef).data.get('schema_version', 0) == 1
        && firestore.get(contextRef).data.get('group_id', '') is string
        && firestore.exists(/databases/(default)/documents/groups/$(firestore.get(contextRef).data.group_id))
        && firestore.get(/databases/(default)/documents/groups/$(firestore.get(contextRef).data.group_id)).data.teacher_id
          == request.auth.uid
        && firestore.exists(/databases/(default)/documents/group_memberships/$(firestore.get(contextRef).data.group_id + '_' + traineeId))
        && firestore.get(/databases/(default)/documents/group_memberships/$(firestore.get(contextRef).data.group_id + '_' + traineeId)).data.group_id
          == firestore.get(contextRef).data.group_id
        && firestore.get(/databases/(default)/documents/group_memberships/$(firestore.get(contextRef).data.group_id + '_' + traineeId)).data.teacher_id
          == request.auth.uid
        && firestore.get(/databases/(default)/documents/group_memberships/$(firestore.get(contextRef).data.group_id + '_' + traineeId)).data.trainee_id
          == traineeId
        && firestore.get(/databases/(default)/documents/group_memberships/$(firestore.get(contextRef).data.group_id + '_' + traineeId)).data.status
          == 'approved'
        && sessionEvidenceEnabled(traineeId);
    }

    function isValidProfileImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    // Canonical filename is the identity source. Windows Firebase C++ desktop
    // uploads object bytes first, then PATCHes custom metadata. Never trust
    // custom metadata as the only identifier during CREATE/DELETE.
    function isCanonicalAssignmentMp4Name(fileName) {
      return fileName.matches('^(review_sub_|activity_)[A-Za-z0-9_-]+[.]mp4$');
    }

    function attemptIdFromCanonicalFileName(fileName) {
      return fileName[0:fileName.size() - 4];
    }

    function assignmentMetadataKeys() {
      return ['teacher_id', 'group_id', 'assignment_id', 'trainee_id',
        'attempt_id', 'movement_id', 'revision_id'];
    }

    function assignmentCustomMetadataAbsent(meta) {
      return meta == null || meta.size() == 0;
    }

    function assignmentPathMetadataMatches(
        meta, teacherId, groupId, assignmentId, traineeId, attemptId) {
      return meta != null
        && meta.keys().hasAll(assignmentMetadataKeys())
        && meta.teacher_id == teacherId
        && meta.group_id == groupId
        && meta.assignment_id == assignmentId
        && meta.trainee_id == traineeId
        && meta.attempt_id == attemptId;
    }

    function assignmentAttemptMetadataMatches(meta, movementId, revisionId) {
      return meta != null
        && meta.movement_id == movementId
        && meta.revision_id == revisionId;
    }

    function assignmentCustomMetadataMatches(
        meta, teacherId, groupId, assignmentId, traineeId, attemptId, attempt) {
      return assignmentPathMetadataMatches(
          meta, teacherId, groupId, assignmentId, traineeId, attemptId
        )
        && assignmentAttemptMetadataMatches(
          meta, attempt.movement_id, attempt.revision_id
        );
    }

    function assignmentCreateMetadataCompatible(
        meta, teacherId, groupId, assignmentId, traineeId, attemptId, attempt) {
      return assignmentCustomMetadataAbsent(meta)
        || (
          assignmentCustomMetadataMatches(
            meta, teacherId, groupId, assignmentId, traineeId, attemptId, attempt
          )
          && meta.size() == 7
        );
    }

    function isImmutableStoredObjectBytes() {
      return request.resource.size == resource.size
        && request.resource.md5Hash == resource.md5Hash
        && request.resource.crc32c == resource.crc32c
        && request.resource.contentType == resource.contentType
        && request.resource.contentType == 'video/mp4'
        && resource.contentType == 'video/mp4'
        && resource.size > 0
        && resource.size <= 50 * 1024 * 1024;
    }

    function isAssignmentMetadataBootstrapTransition() {
      let previous = resource.metadata == null ? {} : resource.metadata;
      let next = request.resource.metadata == null ? {} : request.resource.metadata;
      let changed = next.diff(previous).affectedKeys();
      return assignmentCustomMetadataAbsent(resource.metadata)
        && changed.size() == 7
        && changed.hasAll(assignmentMetadataKeys());
    }

    function submissionAttemptMatchesPath(attempt, teacherId, groupId, assignmentId, traineeId, attemptId) {
      return attempt.teacher_id == teacherId
        && attempt.group_id == groupId
        && attempt.assignment_id == assignmentId
        && attempt.trainee_id == traineeId
        && attempt.attempt_kind == 'teacher_review_submission'
        && attempt.origin == 'teacher_created'
        && attempt.assessment_mode == 'teacher_reviewed'
        && attempt.awards_global_xp == false;
    }

    function isReviewableSubmissionStatus(status) {
      return status in ['submitted', 'approved', 'needs_retry', 'checked'];
    }

    function isCurrentTraineeOfTeacher(teacherId) {
      let contextRef = /databases/(default)/documents/classroom_teacher_access/$(teacherId + '_' + request.auth.uid);
      let context = firestore.get(contextRef).data;
      let membership = firestore.get(
        /databases/(default)/documents/group_memberships/$(context.group_id + '_' + request.auth.uid)
      ).data;
      return isSignedIn()
        && context.teacher_id == teacherId
        && context.trainee_id == request.auth.uid
        && context.schema_version == 1
        && context.group_id is string
        && membership.group_id == context.group_id
        && membership.teacher_id == teacherId
        && membership.trainee_id == request.auth.uid
        && membership.status == 'approved';
    }

    function isCanonicalSubmissionAttempt(attemptId, attempt) {
      return attemptId == 'review_sub_' + attempt.assignment_id + '_'
        + attempt.trainee_id;
    }

    function isAbandonedTeacherReviewAnchor(attempt) {
      return attempt.attempt_kind == 'teacher_review_submission'
        && attempt.keys().hasAny(['abandoned_at'])
        && attempt.abandoned_at is timestamp;
    }

    function isActiveSubmissionUploadAnchor(attempt) {
      return attempt.status in ['draft', 'in_progress']
        && !isAbandonedTeacherReviewAnchor(attempt);
    }

    function isTeacherActivityAttempt(attempt) {
      return attempt.keys().hasAll([
        'assignment_configuration_revision', 'activity_assessment_snapshot',
        'recording_started_at'
      ])
        && attempt.assignment_configuration_revision is int
        && attempt.recording_started_at is timestamp;
    }

    // Cloud Storage Security Rules allow at most two Firestore document accesses
    // per request. Keep the submission attempt and membership bound once per
    // evaluation; do not reintroduce repeated get/exists calls.

    function canCreateAssignmentSubmission(
        teacherId, groupId, assignmentId, traineeId, attemptId) {
      let attempt = firestore.get(
        /databases/(default)/documents/assignment_attempts/$(attemptId)
      ).data;
      let membership = firestore.get(
        /databases/(default)/documents/group_memberships/$(groupId + '_' + traineeId)
      ).data;
      return submissionAttemptMatchesPath(
          attempt, teacherId, groupId, assignmentId, traineeId, attemptId
        )
        && isActiveSubmissionUploadAnchor(attempt)
        && (
          isTeacherActivityAttempt(attempt)
          || (
            membership.group_id == groupId
            && membership.teacher_id == teacherId
            && membership.trainee_id == traineeId
            && membership.status == 'approved'
          )
        )
        && assignmentCreateMetadataCompatible(
          request.resource.metadata,
          teacherId, groupId, assignmentId, traineeId, attemptId, attempt
        );
    }

    function canBootstrapAssignmentSubmissionMetadata(
        teacherId, groupId, assignmentId, traineeId, attemptId) {
      let attempt = firestore.get(
        /databases/(default)/documents/assignment_attempts/$(attemptId)
      ).data;
      let membership = firestore.get(
        /databases/(default)/documents/group_memberships/$(groupId + '_' + traineeId)
      ).data;
      return submissionAttemptMatchesPath(
          attempt, teacherId, groupId, assignmentId, traineeId, attemptId
        )
        && isActiveSubmissionUploadAnchor(attempt)
        && (
          isTeacherActivityAttempt(attempt)
          || (
            membership.group_id == groupId
            && membership.teacher_id == teacherId
            && membership.trainee_id == traineeId
            && membership.status == 'approved'
          )
        )
        && isImmutableStoredObjectBytes()
        && isAssignmentMetadataBootstrapTransition()
        && assignmentCustomMetadataMatches(
          request.resource.metadata,
          teacherId, groupId, assignmentId, traineeId, attemptId, attempt
        );
    }

    function canReadAssignmentSubmission(
        teacherId, groupId, assignmentId, traineeId, attemptId) {
      let attempt = firestore.get(
        /databases/(default)/documents/assignment_attempts/$(attemptId)
      ).data;
      return submissionAttemptMatchesPath(
          attempt, teacherId, groupId, assignmentId, traineeId, attemptId
        )
        && assignmentCustomMetadataMatches(
          resource.metadata,
          teacherId, groupId, assignmentId, traineeId, attemptId, attempt
        )
        && (
          (
            request.auth.uid == traineeId
            && (
              !isCanonicalSubmissionAttempt(attemptId, attempt)
              || attempt.status != 'unsubmitting'
            )
          )
          || (
            request.auth.uid == teacherId
            && isReviewableSubmissionStatus(attempt.status)
          )
        );
    }

    function canDeleteAssignmentSubmission(
        teacherId, groupId, assignmentId, traineeId, attemptId) {
      let attempt = firestore.get(
        /databases/(default)/documents/assignment_attempts/$(attemptId)
      ).data;
      return submissionAttemptMatchesPath(
          attempt, teacherId, groupId, assignmentId, traineeId, attemptId
        )
        && (
          (
            request.auth.uid == traineeId
            && (
              isCanonicalSubmissionAttempt(attemptId, attempt)
                ? (
                    attempt.status == 'unsubmitting'
                    || (
                      attempt.status == 'in_progress'
                      && attempt.keys().hasAny(['draft_cleanup_started_at'])
                      && attempt.draft_cleanup_started_at is timestamp
                    )
                  )
                : true
            )
          )
          || (
            request.auth.uid == teacherId
            && (
              isReviewableSubmissionStatus(attempt.status)
              || isAbandonedTeacherReviewAnchor(attempt)
            )
          )
        );
    }

    // Assignment Submission Authorization is independent of Public Profile,
    // Progress Access, and General Evidence Access.

    match /assignment_submissions/{teacherId}/{groupId}/{assignmentId}/{traineeId}/{fileName} {
      allow read: if isSignedIn()
        && isCanonicalAssignmentMp4Name(fileName)
        && canReadAssignmentSubmission(
          teacherId, groupId, assignmentId, traineeId,
          attemptIdFromCanonicalFileName(fileName)
        );

      allow create: if isOwner(traineeId)
        && isCanonicalAssignmentMp4Name(fileName)
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'video/mp4'
        && canCreateAssignmentSubmission(
          teacherId, groupId, assignmentId, traineeId,
          attemptIdFromCanonicalFileName(fileName)
        );

      allow update: if isOwner(traineeId)
        && isCanonicalAssignmentMp4Name(fileName)
        && canBootstrapAssignmentSubmissionMetadata(
          teacherId, groupId, assignmentId, traineeId,
          attemptIdFromCanonicalFileName(fileName)
        );

      allow delete: if isSignedIn()
        && isCanonicalAssignmentMp4Name(fileName)
        && canDeleteAssignmentSubmission(
          teacherId, groupId, assignmentId, traineeId,
          attemptIdFromCanonicalFileName(fileName)
        );
    }

    // Quarantine is write-only to the one short-lived, server-created object.
    // There are no client reads, rewrites, or deletes from this namespace.
    match /activity_material_staging/{teacherId}/{assignmentId}/{uploadId} {
      allow create: if teacherId.matches('^[A-Za-z0-9_-]+$')
        && assignmentId.matches('^[A-Za-z0-9_-]+$')
        && uploadId.matches('^[A-Za-z0-9-]+$')
        && canCreateActivityMaterialStaging(teacherId, assignmentId, uploadId);
      allow read, update, delete: if false;
    }

    // Published objects are written only by Admin SDK validation code. A
    // bounded access projection grants exactly the owner or eligible audience,
    // including only targeted Trainees for selected Activities.
    match /activity_learning_materials/{assignmentId}/{materialId} {
      allow read: if assignmentId.matches('^[A-Za-z0-9_-]+$')
        && materialId.matches('^[A-Za-z0-9-]+$')
        && hasActivityMaterialAccess(assignmentId, materialId);
      allow write: if false;
    }

    // Private reusable Activity demonstrations. Teachers own the bytes; only
    // their currently approved classroom trainees may read them. Assignments
    // persist an immutable storage path in their configuration snapshot.
    match /teacher_activity_demos/{teacherId}/{fileName} {
      allow read: if fileName.matches('^[A-Za-z0-9_-]+[.]mp4$')
        && (isOwner(teacherId) || isCurrentTraineeOfTeacher(teacherId));
      allow create: if isOwner(teacherId)
        && fileName.matches('^[A-Za-z0-9_-]+[.]mp4$')
        && request.resource.contentType == 'video/mp4'
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.metadata != null
        && request.resource.metadata.size() == 1
        && request.resource.metadata.owner_id == teacherId;
      // Revision and Assignment snapshots point at immutable object paths.
      // Cleanup is server-authoritative after reference analysis.
      allow update, delete: if false;
    }

    // Assignment-specific demo overrides use an Assignment-owned prefix so
    // the authenticated server cascade can remove them with the Assignment.
    match /teacher_activity_demos/{teacherId}/assignments/{assignmentId}/{fileName} {
      allow read: if fileName.matches('^[A-Za-z0-9_-]+[.]mp4$')
        && (isOwner(teacherId) || isCurrentTraineeOfTeacher(teacherId));
      allow create: if isOwner(teacherId)
        && assignmentId.matches('^[A-Za-z0-9_-]+$')
        && fileName.matches('^[A-Za-z0-9_-]+[.]mp4$')
        && request.resource.contentType == 'video/mp4'
        && request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.metadata != null
        && request.resource.metadata.size() == 1
        && request.resource.metadata.owner_id == teacherId;
      allow update, delete: if false;
    }

    // Authenticated users may view any profile avatar (shown across the
    // app in the sidebar, profile menu, and profile settings). Only the
    // owning UID may create, replace, or delete files under their own
    // profile path.
    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidProfileImage();
      allow delete: if isOwner(userId);
    }

    // A single private, annotated still may be retained for a confirmed
    // Guided Practice session. The exact path prevents arbitrary file trees;
    // content and size checks match the client/backend contract.
    match /users/{userId}/session_evidence/{fileName} {
      allow read: if fileName.matches('^[^/]+\\.jpg$')
        && (isOwner(userId)
          || hasTeacherEvidenceGrant(userId)
          || hasTeacherClassroomEvidenceGrant(userId));
      allow create, update: if isOwner(userId)
        && fileName.matches('^[^/]+\\.jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size >= 1024
        && request.resource.size <= 256 * 1024;
      allow delete: if isOwner(userId);
    }

    // No other paths are provisioned; deny by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
