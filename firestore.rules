            resource.data.trainee_id == request.auth.uid
            && attemptId != 'review_sub_' + resource.data.assignment_id + '_'
              + resource.data.trainee_id
          )
        )
        && resource.data.attempt_kind == 'teacher_review_submission'
        && resource.data.status in ['submitted', 'approved', 'needs_retry', 'checked']
        && (resource.data.status != 'checked'
          || resource.data.teacher_id == request.auth.uid)
        && assignmentAttemptIdentityUnchanged()
        && assignmentAttemptReviewUnchanged()
        && assignmentAttemptReviewableMetadataUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['video_storage_path', 'video_deleted_at',
            'deletion_failed', 'deletion_failed_at'])
        && (
          (
            !after.keys().hasAny(['video_storage_path'])
            && after.video_deleted_at == request.time
            && after.deletion_failed == false
