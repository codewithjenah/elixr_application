    }
    function validCanonicalTeacherReviewSubmissionBeginUnsubmit(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId == 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'submitted'
        && after.status == 'unsubmitting'
        && assignmentSubmissionIsOpen(resource.data)
        && assignmentAttemptIdentityUnchanged()
        && assignmentAttemptVideoIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionSubmittedKeys().concat([
          'deletion_failed', 'deletion_failed_at'
        ]))
        && after.deletion_failed == false
        && !after.keys().hasAny(['deletion_failed_at'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'deletion_failed', 'deletion_failed_at']);
    }
    function validCanonicalTeacherReviewSubmissionCompleteUnsubmit(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId == 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'unsubmitting'
        && after.status == 'in_progress'
        && assignmentAttemptIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionAnchorKeys())
        && after.deletion_failed == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'video_storage_path', 'video_content_type',
            'video_size_bytes', 'video_duration_ms', 'submitted_at',
            'video_expires_at', 'video_deleted_at', 'deletion_failed',
            'deletion_failed_at'
          ]);
    }
    function validCanonicalTeacherReviewSubmissionDeletionFailure(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId == 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'unsubmitting'
        && after.status == 'unsubmitting'
        && assignmentAttemptIdentityUnchanged()
        && assignmentAttemptVideoIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionSubmittedKeys().concat([
          'deletion_failed', 'deletion_failed_at'
        ]))
        && after.deletion_failed == true
        && after.deletion_failed_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deletion_failed', 'deletion_failed_at']);
    }
    function validCanonicalTeacherReviewSubmissionCheckedReview() {
      let after = request.resource.data;
      let assignment = get(assignmentPath(resource.data.assignment_id)).data;
      let maxScore = assignment.get('max_score', 100);
      let previousMax = resource.get('grade_max_score', maxScore);
      return resource.data.teacher_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && resource.data.status in ['submitted', 'checked', 'approved', 'needs_retry']
        && after.status == 'checked'
        && assignment.get('max_score', 100) == maxScore
        && assignmentAttemptIdentityUnchanged()
        && assignmentAttemptVideoIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionCheckedKeys())
        && after.grade_score is int
        && after.grade_max_score is int
        && after.grade_max_score == previousMax
        && after.grade_max_score >= 1
        && after.grade_max_score <= 100
        && after.grade_score >= 0
        && after.grade_score <= after.grade_max_score
        && after.checked_at is timestamp
        && (
          resource.data.status != 'checked'
          ? after.checked_at == request.time
          : after.checked_at == resource.data.checked_at
        )
        && after.review_updated_at == request.time
        && after.review_revision is int
        && after.review_revision == resource.get('review_revision', 0) + 1
        && !after.keys().hasAny([
          'review_verdict', 'reviewed_at', 'result_sent_revision',
          'result_sent_at', 'result_message_id'
        ])
        && after.video_expires_at is timestamp
        && isReviewedVideoExpiry(after.video_expires_at)
        && (
          !after.keys().hasAny(['review_feedback'])
          || isBoundedText(after.review_feedback, 1000)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
