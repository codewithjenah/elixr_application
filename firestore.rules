          || (
            after.get('video_storage_path', '__elixr_absent__')
              == resource.data.get('video_storage_path', '__elixr_absent__')
            && after.deletion_failed == true
            && (
              !after.keys().hasAny(['deletion_failed_at'])
              || after.deletion_failed_at == request.time
            )
          )
        );
    }

    function teacherReviewSubmissionHasNoSubmitOrReviewPayload(data) {
      return !data.keys().hasAny([
        'source_session_id', 'submitted_at', 'video_expires_at',
        'video_storage_path', 'video_content_type', 'video_size_bytes',
        'video_duration_ms', 'review_verdict', 'review_feedback',
        'reviewed_at', 'grade_score', 'grade_max_score', 'checked_at',
        'review_updated_at', 'review_revision', 'result_sent_revision',
        'result_sent_at', 'result_message_id'
      ]);
    }
    function validTeacherReviewSubmissionAbandon(attemptId) {
      let after = request.resource.data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId != 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'draft'
        && resource.data.awards_global_xp == false
        && !resource.data.keys().hasAny(['abandoned_at'])
        && teacherReviewSubmissionHasNoSubmitOrReviewPayload(resource.data)
        && !resource.data.keys().hasAny([
          'video_deleted_at', 'deletion_failed', 'deletion_failed_at'
        ])
        && after.status == 'draft'
        && after.awards_global_xp == false
        && assignmentAttemptIdentityUnchanged()
        && after.abandoned_at == request.time
        && teacherReviewSubmissionHasNoSubmitOrReviewPayload(after)
        && changed.hasOnly(['abandoned_at', 'video_deleted_at',
          'deletion_failed', 'deletion_failed_at'])
        && (
          (
            !after.keys().hasAny(['video_deleted_at', 'deletion_failed',
              'deletion_failed_at'])
          )
          || (
            after.video_deleted_at == request.time
            && (
              !after.keys().hasAny(['deletion_failed'])
              || after.deletion_failed == false
            )
            && !after.keys().hasAny(['deletion_failed_at'])
          )
          || (
            !after.keys().hasAny(['video_deleted_at'])
            && after.deletion_failed == true
            && after.deletion_failed_at == request.time
