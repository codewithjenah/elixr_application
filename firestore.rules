        && after.abandoned_at == resource.data.abandoned_at
        && assignmentAttemptIdentityUnchanged()
        && teacherReviewSubmissionHasNoSubmitOrReviewPayload(after)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['video_storage_path', 'video_deleted_at',
