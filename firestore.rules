            && after.deletion_failed == false
          )
          || (
            after.deletion_failed == true
            && after.deletion_failed_at == request.time
            && after.get('video_deleted_at', '__elixr_absent__')
              == resource.data.get('video_deleted_at', '__elixr_absent__')
            && after.get('video_storage_path', '__elixr_absent__')
              == resource.data.get('video_storage_path', '__elixr_absent__')
          )
        );
