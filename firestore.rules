rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    function markerPath(sessionId) {
      return /databases/$(database)/documents/leaderboard_processed_sessions/$(sessionId);
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/daily_quest_boards/$(boardId);
    }

    // Canonical board id shape used by create + account-erasure enumeration:
    // <authUid>_<yyyyMMdd>. Used to authorize idempotent deletes of missing
    // deterministic board IDs without opening arbitrary missing-doc deletes.
    function isCanonicalOwnDailyQuestBoardId(boardId) {
      return isSignedIn()
        && boardId.matches('^' + request.auth.uid + '_[0-9]{8}$');
    }

    function isCanonicalOwnTrainingPlanId(planId, dayKey) {
      return isSignedIn()
        && dayKey is string
        && dayKey.matches('^[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])$')
        && planId == request.auth.uid + '_' + dayKey;
    }

    function claimPath(claimId) {
      return /databases/$(database)/documents/daily_quest_claims/$(claimId);
    }

    function leaderboardPath(userId) {
      return /databases/$(database)/documents/leaderboard/$(userId);
    }

    function leaderboardKeys() {
      return [
        'user_id',
        'display_name',
        'profile_picture_url',
        'total_xp',
        'sessions_completed',
        'score_sum',
        'average_score',
        'best_score',
        'last_session_at',
        'updated_at',
        'last_awarded_session_id',
        'quest_xp',
        'last_claim_id',
        'equipped_border_id',
        'daily_key',
        'daily_xp',
        'daily_sessions_completed',
        'daily_score_sum',
        'daily_average_score',
        'daily_best_score',
        'monthly_key',
        'monthly_xp',
        'monthly_sessions_completed',
        'monthly_score_sum',
        'monthly_average_score',
        'monthly_best_score'
      ];
    }

    function dailyLeaderboardKeys() {
      return [
        'daily_key',
        'daily_xp',
        'daily_sessions_completed',
        'daily_score_sum',
        'daily_average_score',
        'daily_best_score'
      ];
    }

    function monthlyLeaderboardKeys() {
      return [
        'monthly_key',
        'monthly_xp',
        'monthly_sessions_completed',
        'monthly_score_sum',
        'monthly_average_score',
        'monthly_best_score'
      ];
    }

    function periodLeaderboardKeys() {
      return [
        'daily_key',
        'daily_xp',
        'daily_sessions_completed',
        'daily_score_sum',
        'daily_average_score',
        'daily_best_score',
        'monthly_key',
        'monthly_xp',
        'monthly_sessions_completed',
        'monthly_score_sum',
        'monthly_average_score',
        'monthly_best_score'
      ];
    }

    function achievementClaimPath(claimId) {
      return /databases/$(database)/documents/achievement_claims/$(claimId);
    }

    function userCosmeticsPath(userId) {
      return /databases/$(database)/documents/user_cosmetics/$(userId);
    }

    // ---- Achievement / profile-border catalog (Phase 2) --------------------
    // Duplicated deliberately from lib/data/models/achievement.dart and
    // lib/data/models/profile_border.dart. Guarded by
    // test/data/models/achievement_catalog_contract_test.dart.
    //
    // CAPSTONE SECURITY NOTE: these rules enforce fixed reward mappings,
    // ownership, atomic claim↔cosmetics linkage, idempotency, and
    // equip-only-if-unlocked. They do NOT independently verify that an
    // achievement was completed — completion remains client-evaluated.
    // Because Phase 2 rewards are cosmetic and grant no XP, modified-client
    // impact is limited to the attacker's own cosmetics. Trusted callable-
    // function evaluation remains the future hostile-client hardening path.
    function achievementIds() {
      return [
        'first_steps',
        'getting_started',
        'flair_regular',
        'century_club',
        'sharp_pour',
        'perfect_serve',
        'movement_explorer',
        'versatility_master',
        'week_warrior',
        'bottle_in_tin_specialist'
      ];
    }

    function profileBorderIds() {
      return [
        'starter_glow',
        'bronze_ember',
        'violet_flow',
        'gold_mastery',
        'cyan_orbit',
        'perfect_serve',
        'prismatic_arc',
        'triad_frame',
        'week_warrior',
        'tin_specialist'
      ];
    }

    function rewardBorderForAchievement(id) {
      return id == 'first_steps' ? 'starter_glow'
        : id == 'getting_started' ? 'bronze_ember'
        : id == 'flair_regular' ? 'violet_flow'
        : id == 'century_club' ? 'gold_mastery'
        : id == 'sharp_pour' ? 'cyan_orbit'
        : id == 'perfect_serve' ? 'perfect_serve'
        : id == 'movement_explorer' ? 'prismatic_arc'
        : id == 'versatility_master' ? 'triad_frame'
        : id == 'week_warrior' ? 'week_warrior'
        : id == 'bottle_in_tin_specialist' ? 'tin_specialist'
        : '';
    }

    function isKnownAchievementId(id) {
      return id in achievementIds();
    }

    function isKnownProfileBorderId(id) {
      return id in profileBorderIds();
    }

    function achievementClaimKeys() {
      return ['user_id', 'achievement_id', 'reward_border_id', 'claimed_at'];
    }

    function cosmeticsKeys() {
      return [
        'user_id',
        'unlocked_border_ids',
        'last_achievement_claim_id',
        'created_at',
        'updated_at'
      ];
    }

    function equippedBorderOf(data) {
      return data.get('equipped_border_id', '');
    }

    function equippedBorderUnchanged() {
      return equippedBorderOf(request.resource.data) == equippedBorderOf(resource.data);
    }

    function profilePictureUnchanged() {
      return (!resource.data.keys().hasAny(['profile_picture_url'])
          && !request.resource.data.keys().hasAny(['profile_picture_url']))
        || (resource.data.keys().hasAny(['profile_picture_url'])
          && request.resource.data.keys().hasAny(['profile_picture_url'])
          && request.resource.data.profile_picture_url
            == resource.data.profile_picture_url);
    }

    function oldBordersPreserved(oldList, newList) {
      return (oldList.size() < 1 || oldList[0] in newList)
        && (oldList.size() < 2 || oldList[1] in newList)
        && (oldList.size() < 3 || oldList[2] in newList)
        && (oldList.size() < 4 || oldList[3] in newList)
        && (oldList.size() < 5 || oldList[4] in newList)
        && (oldList.size() < 6 || oldList[5] in newList)
        && (oldList.size() < 7 || oldList[6] in newList)
        && (oldList.size() < 8 || oldList[7] in newList)
        && (oldList.size() < 9 || oldList[8] in newList)
        && (oldList.size() < 10 || oldList[9] in newList);
    }

    function markerKeysV1() {
      return ['session_id', 'user_id', 'score', 'xp_awarded', 'processed_at'];
    }

    function markerKeysV2() {
      return ['session_id', 'user_id', 'rubric_total', 'xp_awarded', 'processed_at'];
    }

    function boardKeys() {
      return ['user_id', 'day_key', 'day_start', 'quest_ids', 'created_at', 'updated_at'];
    }

    function claimKeys() {
      return ['user_id', 'board_id', 'day_key', 'day_start', 'quest_id', 'xp_awarded', 'claimed_at'];
    }

    function isNonNegInt(value) {
      return value is int && value >= 0;
    }

    function trainingPlanRestKeys() {
      return ['user_id', 'day_key', 'plan_type', 'created_at', 'updated_at'];
    }

    function trainingPlanTrainingKeys() {
      return [
        'user_id',
        'day_key',
        'plan_type',
        'movement_name',
        'difficulty',
        'prop_type',
        'target_duration_minutes',
        'created_at',
        'updated_at'
      ];
    }

    function isManilaDayKeyFormat(value) {
      return value is string
        && value.matches('^[0-9]{4}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])$');
    }

    function isAllowedPlanDuration(value) {
      return value is number
        && value == int(value)
        && (value == 5 || value == 10 || value == 15 || value == 20 || value == 30);
    }

    function isActionablePlanDayKey(dayKey) {
      return isManilaDayKeyFormat(dayKey)
        && dayKey >= manilaDayKey(request.time)
        && dayKey <= manilaDayKey(request.time + duration.value(366, 'd'));
    }

    function validRestTrainingPlan(data) {
      return data.keys().hasOnly(trainingPlanRestKeys())
        && data.user_id == request.auth.uid
        && data.plan_type == 'rest'
        && isActionablePlanDayKey(data.day_key)
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function validActiveTrainingPlan(data) {
      return data.keys().hasOnly(trainingPlanTrainingKeys())
        && data.user_id == request.auth.uid
        && data.plan_type == 'training'
        && isActionablePlanDayKey(data.day_key)
        && data.movement_name is string
        && data.movement_name.size() > 0
        && data.movement_name.size() <= 80
        && data.movement_name in coachingMovementNames()
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.prop_type in ['bottle', 'shaker', 'bottle_and_shaker']
        && isAllowedPlanDuration(data.target_duration_minutes)
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function validTrainingPlanWrite(data, planId) {
      return isCanonicalOwnTrainingPlanId(planId, data.day_key)
        && (
          validRestTrainingPlan(data)
          || validActiveTrainingPlan(data)
        );
    }

    // Accept int or whole-number float (Firestore/clients may store either).
    function isScore(value) {
      return value is number
        && value >= 0
        && value <= 100
        && value == int(value);
    }

    function isRubricCriterion(value) {
      return value is int && value >= 0 && value <= 3;
    }

    function isRubricTotal(value) {
      return value is int && value >= 0 && value <= 12;
    }

    // Authoritative thresholds: 0–3 / 4–6 / 7–9 / 10–11 / 12.
    function performanceLevelFor(total) {
      return total <= 3 ? 'beginning'
        : total <= 6 ? 'developing'
        : total <= 9 ? 'competent'
        : total <= 11 ? 'proficient'
        : 'mastered';
    }

    function validRubricMap(rubric) {
      return rubric.keys().hasOnly([
          'technique', 'stability', 'completion', 'prop_positioning'
        ])
        && isRubricCriterion(rubric.technique)
        && isRubricCriterion(rubric.stability)
        && isRubricCriterion(rubric.completion)
        && isRubricCriterion(rubric.prop_positioning);
    }

    function validRubricSession(data) {
      return data.assessment_version == 2
        && data.keys().hasAll([
          'user_id',
          'movement_name',
          'difficulty',
          'duration_seconds',
          'prop_type',
          'created_at',
          'assessment_version',
          'rubric',
          'rubric_total',
          'performance_level'
        ])
        && !data.keys().hasAny(['score'])
        && validRubricMap(data.rubric)
        && isRubricTotal(data.rubric_total)
        && data.rubric_total
          == data.rubric.technique
            + data.rubric.stability
            + data.rubric.completion
            + data.rubric.prop_positioning
        && data.performance_level == performanceLevelFor(data.rubric_total);
    }

    // Evidence is private session metadata, never a public URL. It is written
    // only with the initial session create after a successful owner upload.
    function validSessionEvidence(data, sessionId) {
      return !data.keys().hasAny(['evidence_storage_path', 'evidence_kind', 'evidence_size_bytes'])
        || (
          data.keys().hasAll(['evidence_storage_path', 'evidence_kind', 'evidence_size_bytes'])
          && data.evidence_storage_path is string
          && data.evidence_storage_path == 'users/' + request.auth.uid + '/session_evidence/' + sessionId + '.jpg'
          && data.evidence_kind == 'hold_confirmed'
          && data.evidence_size_bytes is int
          && data.evidence_size_bytes >= 1024
          && data.evidence_size_bytes <= 256 * 1024
        );
    }

    // Privacy revocation may remove evidence metadata; it may never replace
    // an existing reference or attach one to an old session.
    function sessionEvidenceUnchangedOrRemoved() {
      return (!resource.data.keys().hasAny(['evidence_storage_path', 'evidence_kind', 'evidence_size_bytes'])
          && !request.resource.data.keys().hasAny(['evidence_storage_path', 'evidence_kind', 'evidence_size_bytes']))
        || (!request.resource.data.keys().hasAny(['evidence_storage_path', 'evidence_kind', 'evidence_size_bytes']))
        || (resource.data.evidence_storage_path == request.resource.data.evidence_storage_path
          && resource.data.evidence_kind == request.resource.data.evidence_kind
          && resource.data.evidence_size_bytes == request.resource.data.evidence_size_bytes);
    }

    // Completed-session identity is frozen after create. Historical
    // non-official movement_name values (Arm Stall, custom names, etc.) must
    // never be rewritten to an official catalog identity to gain XP.
    function sessionIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'movement_name', 'difficulty', 'prop_type', 'duration_seconds',
        'assessment_version', 'assignment_context'
      ]);
    }

    // Firestore clients and the rules runtime can round the same repeating
    // division to adjacent IEEE-754 values. Compare the reconstructed sum
    // within a sub-micro-point tolerance so legitimate averages such as
    // 250 / 3 validate without permitting a meaningful forged metric.
    function averageMatches(average, count, sum) {
      let reconstructed = average * count;
      return average is number
        && reconstructed >= sum - 0.000001
        && reconstructed <= sum + 0.000001;
    }

    function isValidHttpsProfilePictureUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches('^https://.*');
    }

    // Tolerant accessors: quest_xp / last_claim_id are optional on legacy
    // leaderboard documents and on documents that have only ever received a
    // session award or a public-profile-metadata update. Using Map.get(key,
    // default) here (rather than requiring the key via hasAll) means those
    // documents, and writes that never touch these fields, keep validating
    // correctly without a backfill migration.
    function questXpOf(data) {
      return data.get('quest_xp', 0);
    }

    function lastClaimIdOf(data) {
      return data.get('last_claim_id', '');
    }

    // ---- Daily quest catalog (Phase 1) -------------------------------------
    // Duplicated deliberately from lib/data/models/daily_quest.dart because
    // security rules cannot import Dart source. A Dart-side contract test
    // (test/data/models/daily_quest_catalog_contract_test.dart) parses this
    // file and fails loudly if the two ever diverge.
    //
    // CAPSTONE SECURITY NOTE: these rules verify XP arithmetic, catalog
    // membership, claim-replay safety, and the Asia/Manila real-day window —
    // they do NOT independently verify that a quest was actually completed
    // (e.g. "did the player really finish 3 sessions today"). Quest
    // completion is evaluated client-side (see GamificationRepository).
    // That check is a UX / defense-in-depth guard only, not a security
    // boundary. Moving completion verification into a trusted Firebase
    // callable function is the recommended hardening for a future phase
    // with a hostile-client threat model.
    function questCatalogIds() {
      return [
        'session_count_1', 'session_count_3', 'session_count_5',
        'duration_10min', 'duration_20min', 'duration_30min',
        'score_70', 'score_85', 'score_95',
        'sessions_above_70_x2',
        'two_movements', 'three_movements',
        'practice_easy_movement', 'practice_medium_movement', 'practice_hard_movement',
        'use_shaker', 'distinct_props_2', 'use_bottle_and_shaker_combo'
      ];
    }

    function easyIds() {
      return ['session_count_1', 'duration_10min', 'score_70', 'two_movements',
              'practice_easy_movement', 'use_shaker'];
    }

    function mediumIds() {
      return ['session_count_3', 'duration_20min', 'score_85', 'sessions_above_70_x2',
              'three_movements', 'practice_medium_movement', 'distinct_props_2'];
    }

    function hardIds() {
      return ['session_count_5', 'duration_30min', 'score_95',
              'practice_hard_movement', 'use_bottle_and_shaker_combo'];
    }

    function sessionCountIds() {
      return ['session_count_1', 'session_count_3', 'session_count_5'];
    }

    function durationIds() {
      return ['duration_10min', 'duration_20min', 'duration_30min'];
    }

    function scoreThresholdIds() {
      return ['score_70', 'score_85', 'score_95'];
    }

    function isKnownQuestId(id) {
      return id in questCatalogIds();
    }

    function questXpFor(id) {
      return id in easyIds() ? 10 : (id in mediumIds() ? 15 : (id in hardIds() ? 20 : -1));
    }

    function countInSet(ids, allowed) {
      return (ids[0] in allowed ? 1 : 0) + (ids[1] in allowed ? 1 : 0) + (ids[2] in allowed ? 1 : 0)
           + (ids[3] in allowed ? 1 : 0) + (ids[4] in allowed ? 1 : 0);
    }

    // ---- Asia/Manila real-day window (server-time-anchored) ---------------
    // request.time is stamped by the Firestore server at commit time and is
    // never client-supplied, which is exactly why it is the only trustworthy
    // basis for "what real day is it". A client cannot spoof it by changing
    // its device clock or by passing an arbitrary day_key/day_start.
    function manilaOffset() {
      return duration.value(8, 'h');
    }

    function twoDigit(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Exact UTC instant of 00:00 Asia/Manila for the Manila calendar day
    // that contains server timestamp ts.
    function manilaDayStart(ts) {
      let shifted = ts + manilaOffset();
      return timestamp.date(shifted.year(), shifted.month(), shifted.day()) - manilaOffset();
    }

    // Exact 'yyyyMMdd' for the Manila calendar day that contains server
    // timestamp ts.
    function manilaDayKey(ts) {
      let shifted = ts + manilaOffset();
      return string(shifted.year()) + twoDigit(shifted.month()) + twoDigit(shifted.day());
    }

    // Exact 'yyyyMM' for the Manila calendar month that contains timestamp ts.
    function manilaMonthKey(ts) {
      let shifted = ts + manilaOffset();
      return string(shifted.year()) + twoDigit(shifted.month());
    }

    function validLeaderboardShape(data) {
      return data.keys().hasOnly(leaderboardKeys())
        && data.user_id is string
        && data.user_id == request.auth.uid
        && data.display_name is string
        && data.display_name.size() > 0
        && data.display_name.size() <= 80
        && (!data.keys().hasAny(['profile_picture_url'])
          || isValidHttpsProfilePictureUrl(data.profile_picture_url))
        && isNonNegInt(data.total_xp)
        && isNonNegInt(data.sessions_completed)
        && (!data.keys().hasAny(['quest_xp']) || isNonNegInt(data.quest_xp))
        && (!data.keys().hasAny(['last_claim_id']) || data.last_claim_id is string)
        && (!data.keys().hasAny(['equipped_border_id'])
          || (data.equipped_border_id is string
            && (data.equipped_border_id == ''
              || isKnownProfileBorderId(data.equipped_border_id))))
        && data.total_xp == data.sessions_completed * 25 + questXpOf(data)
        && data.score_sum is number
        && data.score_sum >= 0
        && data.average_score is number
        && data.average_score >= 0
        && data.average_score <= 100
        && isScore(data.best_score)
        && data.last_awarded_session_id is string
        && data.last_awarded_session_id.size() > 0
        && data.keys().hasAll([
          'user_id',
          'display_name',
          'total_xp',
          'sessions_completed',
          'score_sum',
          'average_score',
          'best_score',
          'last_session_at',
          'updated_at',
          'last_awarded_session_id'
        ]);
    }

    function validLeaderboardPublicMetadata(data) {
      return data.display_name is string
        && data.display_name.size() > 0
        && data.display_name.size() <= 80
        && (!data.keys().hasAny(['profile_picture_url'])
          || isValidHttpsProfilePictureUrl(data.profile_picture_url));
    }

    // Update paths below independently validate every mutable aggregate and
    // the equipped-border transition. The shared update shape therefore only
    // enforces the document/key, identity, timestamp, and public-metadata
    // contract; rechecking every unchanged field here would exceed
    // Firestore's 1,000-expression limit for legitimate older backfills.
    function validLeaderboardUpdateShape(data) {
      return data.keys().hasOnly(leaderboardKeys())
        && data.user_id == request.auth.uid
        && data.updated_at is timestamp
        && validLeaderboardPublicMetadata(data);
    }

    function sourceSession(sessionId) {
      return get(sessionPath(sessionId)).data;
    }

    function markerMatchesLegacySession(sessionId, score) {
      let marker = getAfter(markerPath(sessionId));
      return !exists(markerPath(sessionId))
        && existsAfter(markerPath(sessionId))
        && marker.data.keys().hasOnly(markerKeysV1())
        && marker.data.user_id == request.auth.uid
        && marker.data.session_id == sessionId
        && marker.data.score == score
        && marker.data.xp_awarded == 25;
    }

    function markerMatchesRubricSession(sessionId, rubricTotal) {
      let marker = getAfter(markerPath(sessionId));
      return !exists(markerPath(sessionId))
        && existsAfter(markerPath(sessionId))
        && marker.data.keys().hasOnly(markerKeysV2())
        && marker.data.user_id == request.auth.uid
        && marker.data.session_id == sessionId
        && marker.data.rubric_total == rubricTotal
        && marker.data.xp_awarded == 25;
    }

    function awardSessionId() {
      return request.resource.data.last_awarded_session_id;
    }

    function validAwardSessionTimestamp(createdAt) {
      return createdAt is timestamp && createdAt <= request.time;
    }

    function dailyPeriodUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(dailyLeaderboardKeys());
    }

    function monthlyPeriodUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(monthlyLeaderboardKeys());
    }

    function periodAggregatesUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(periodLeaderboardKeys());
    }

    function dailySessionAggregateReset(score, createdAt) {
      return request.resource.data.daily_key
          == manilaDayKey(createdAt)
        && request.resource.data.daily_xp == 25
        && request.resource.data.daily_sessions_completed == 1
        && request.resource.data.daily_score_sum == score
        && request.resource.data.daily_average_score == score
        && request.resource.data.daily_best_score == score;
    }

    function monthlySessionAggregateReset(score, createdAt) {
      return request.resource.data.monthly_key
          == manilaMonthKey(createdAt)
        && request.resource.data.monthly_xp == 25
        && request.resource.data.monthly_sessions_completed == 1
        && request.resource.data.monthly_score_sum == score
        && request.resource.data.monthly_average_score == score
        && request.resource.data.monthly_best_score == score;
    }

    function dailySessionAggregateAccumulates(score) {
      return request.resource.data.daily_key == resource.data.daily_key
        && request.resource.data.daily_xp == resource.data.daily_xp + 25
        && request.resource.data.daily_sessions_completed
          == resource.data.daily_sessions_completed + 1
        && request.resource.data.daily_score_sum
          == resource.data.daily_score_sum + score
        && averageMatches(
          request.resource.data.daily_average_score,
          request.resource.data.daily_sessions_completed,
          request.resource.data.daily_score_sum
        )
        && request.resource.data.daily_best_score
          == (
            resource.data.daily_best_score >= score
              ? resource.data.daily_best_score
              : score
          );
    }

    function monthlySessionAggregateAccumulates(score) {
      return request.resource.data.monthly_key == resource.data.monthly_key
        && request.resource.data.monthly_xp == resource.data.monthly_xp + 25
        && request.resource.data.monthly_sessions_completed
          == resource.data.monthly_sessions_completed + 1
        && request.resource.data.monthly_score_sum
          == resource.data.monthly_score_sum + score
        && averageMatches(
          request.resource.data.monthly_average_score,
          request.resource.data.monthly_sessions_completed,
          request.resource.data.monthly_score_sum
        )
        && request.resource.data.monthly_best_score
          == (
            resource.data.monthly_best_score >= score
              ? resource.data.monthly_best_score
              : score
          );
    }

    function validDailySessionAggregateTransition(score, createdAt) {
      let eventKey = manilaDayKey(createdAt);
      return (
          eventKey > resource.data.daily_key
          && dailySessionAggregateReset(score, createdAt)
        )
        || (
          eventKey == resource.data.daily_key
          && dailySessionAggregateAccumulates(score)
        )
        || (eventKey < resource.data.daily_key && dailyPeriodUnchanged());
    }

    function validMonthlySessionAggregateTransition(score, createdAt) {
      let eventKey = manilaMonthKey(createdAt);
      return (
          eventKey > resource.data.monthly_key
          && monthlySessionAggregateReset(score, createdAt)
        )
        || (
          eventKey == resource.data.monthly_key
          && monthlySessionAggregateAccumulates(score)
        )
        || (eventKey < resource.data.monthly_key && monthlyPeriodUnchanged());
    }

    function validSessionPeriodCreate(score, createdAt) {
      return dailySessionAggregateReset(score, createdAt)
        && monthlySessionAggregateReset(score, createdAt);
    }

    function validSessionPeriodUpdate(score, createdAt) {
      let initialized = resource.data.keys().hasAny(['daily_key']);
      return (
          !initialized
          && dailySessionAggregateReset(score, createdAt)
          && monthlySessionAggregateReset(score, createdAt)
        )
        || (
          initialized
          && validDailySessionAggregateTransition(score, createdAt)
          && validMonthlySessionAggregateTransition(score, createdAt)
        );
    }

    // A fully older backfill changes lifetime aggregates while preserving all
    // quest, cosmetic, identity, and period state. Expressing that invariant
    // as the exact set of permitted changed keys avoids expanding both period
    // transition trees and stays below Firestore's 1,000-expression limit.
    function sessionAwardMutableKeys() {
      return [
        'display_name',
        'profile_picture_url',
        'total_xp',
        'sessions_completed',
        'score_sum',
        'average_score',
        'best_score',
        'last_session_at',
        'updated_at',
        'last_awarded_session_id'
      ];
    }

    function validOlderSessionAwardChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        sessionAwardMutableKeys()
      );
    }

    function validCurrentSessionAwardChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        sessionAwardMutableKeys().concat(periodLeaderboardKeys())
      );
    }

    function scoreAggregatesUnchanged() {
      return request.resource.data.score_sum == resource.data.score_sum
        && request.resource.data.average_score == resource.data.average_score
        && request.resource.data.best_score == resource.data.best_score;
    }

    function dailyScoreAggregatesUnchanged() {
      return request.resource.data.daily_score_sum == resource.data.daily_score_sum
        && request.resource.data.daily_average_score
          == resource.data.daily_average_score
        && request.resource.data.daily_best_score == resource.data.daily_best_score;
    }

    function monthlyScoreAggregatesUnchanged() {
      return request.resource.data.monthly_score_sum
          == resource.data.monthly_score_sum
        && request.resource.data.monthly_average_score
          == resource.data.monthly_average_score
        && request.resource.data.monthly_best_score
          == resource.data.monthly_best_score;
    }

    function dailyRubricSessionAggregateReset(createdAt) {
      return request.resource.data.daily_key == manilaDayKey(createdAt)
        && request.resource.data.daily_xp == 25
        && request.resource.data.daily_sessions_completed == 1
        && request.resource.data.daily_score_sum == 0
        && request.resource.data.daily_average_score == 0
        && request.resource.data.daily_best_score == 0;
    }

    function monthlyRubricSessionAggregateReset(createdAt) {
      return request.resource.data.monthly_key == manilaMonthKey(createdAt)
        && request.resource.data.monthly_xp == 25
        && request.resource.data.monthly_sessions_completed == 1
        && request.resource.data.monthly_score_sum == 0
        && request.resource.data.monthly_average_score == 0
        && request.resource.data.monthly_best_score == 0;
    }

    function dailyRubricSessionAggregateAccumulates() {
      return request.resource.data.daily_key == resource.data.daily_key
        && request.resource.data.daily_xp == resource.data.daily_xp + 25
        && request.resource.data.daily_sessions_completed
          == resource.data.daily_sessions_completed + 1
        && dailyScoreAggregatesUnchanged();
    }

    function monthlyRubricSessionAggregateAccumulates() {
      return request.resource.data.monthly_key == resource.data.monthly_key
        && request.resource.data.monthly_xp == resource.data.monthly_xp + 25
        && request.resource.data.monthly_sessions_completed
          == resource.data.monthly_sessions_completed + 1
        && monthlyScoreAggregatesUnchanged();
    }

    function validDailyRubricSessionAggregateTransition(createdAt) {
      let eventKey = manilaDayKey(createdAt);
      return (
          eventKey > resource.data.daily_key
          && dailyRubricSessionAggregateReset(createdAt)
        )
        || (
          eventKey == resource.data.daily_key
          && dailyRubricSessionAggregateAccumulates()
        )
        || (eventKey < resource.data.daily_key && dailyPeriodUnchanged());
    }

    function validMonthlyRubricSessionAggregateTransition(createdAt) {
      let eventKey = manilaMonthKey(createdAt);
      return (
          eventKey > resource.data.monthly_key
          && monthlyRubricSessionAggregateReset(createdAt)
        )
        || (
          eventKey == resource.data.monthly_key
          && monthlyRubricSessionAggregateAccumulates()
        )
        || (eventKey < resource.data.monthly_key && monthlyPeriodUnchanged());
    }

    function validRubricSessionPeriodCreate(createdAt) {
      return dailyRubricSessionAggregateReset(createdAt)
        && monthlyRubricSessionAggregateReset(createdAt);
    }

    function validRubricSessionPeriodUpdate(createdAt) {
      let initialized = resource.data.keys().hasAny(['daily_key']);
      return (
          !initialized
          && dailyRubricSessionAggregateReset(createdAt)
          && monthlyRubricSessionAggregateReset(createdAt)
        )
        || (
          initialized
          && validDailyRubricSessionAggregateTransition(createdAt)
          && validMonthlyRubricSessionAggregateTransition(createdAt)
        );
    }

    function validSessionAwardCreate() {
      let sessionId = awardSessionId();
      let session = get(sessionPath(sessionId));
      let createdAt = session.data.created_at;
      return session != null
        && session.data.user_id == request.auth.uid
        && isOfficialElixrMovementName(session.data.movement_name)
        && validAwardSessionTimestamp(createdAt)
        && request.resource.data.sessions_completed == 1
        && questXpOf(request.resource.data) == 0
        && request.resource.data.total_xp == 25
        && equippedBorderOf(request.resource.data) == ''
        && (
          (
            session.data.get('assessment_version', 1) == 2
            && isRubricTotal(session.data.rubric_total)
            && request.resource.data.score_sum == 0
            && request.resource.data.average_score == 0
            && request.resource.data.best_score == 0
            && validRubricSessionPeriodCreate(createdAt)
            && markerMatchesRubricSession(sessionId, session.data.rubric_total)
          )
          || (
            session.data.get('assessment_version', 1) != 2
            && isScore(session.data.score)
            && request.resource.data.score_sum == session.data.score
            && request.resource.data.average_score == session.data.score
            && request.resource.data.best_score == session.data.score
            && validSessionPeriodCreate(session.data.score, createdAt)
            && markerMatchesLegacySession(sessionId, session.data.score)
          )
        );
    }

    function aggregatesUnchanged() {
      return request.resource.data.user_id == resource.data.user_id
        && request.resource.data.total_xp == resource.data.total_xp
        && request.resource.data.sessions_completed == resource.data.sessions_completed
        && request.resource.data.score_sum == resource.data.score_sum
        && request.resource.data.average_score == resource.data.average_score
        && request.resource.data.best_score == resource.data.best_score
        && request.resource.data.last_awarded_session_id == resource.data.last_awarded_session_id
        && request.resource.data.last_session_at == resource.data.last_session_at
        && questXpOf(request.resource.data) == questXpOf(resource.data)
        && lastClaimIdOf(request.resource.data) == lastClaimIdOf(resource.data)
        && periodAggregatesUnchanged();
    }

    function validSessionAwardUpdate() {
      let sessionId = awardSessionId();
      let session = get(sessionPath(sessionId));
      let createdAt = session.data.created_at;
      let initializedPeriod = resource.data.keys().hasAny(['daily_key']);
      let fullyOlderPeriod = initializedPeriod
        && manilaMonthKey(createdAt) < resource.data.monthly_key;
      let isRubric = session.data.get('assessment_version', 1) == 2;
      return request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.updated_at is timestamp
        && validLeaderboardPublicMetadata(request.resource.data)
        && request.resource.data.sessions_completed
          == resource.data.sessions_completed + 1
        && request.resource.data.total_xp == resource.data.total_xp + 25
        && request.resource.data.last_awarded_session_id
          != resource.data.last_awarded_session_id
        && session.data.user_id == request.auth.uid
        && isOfficialElixrMovementName(session.data.movement_name)
        && validAwardSessionTimestamp(createdAt)
        && (
          isRubric
            ? (
              isRubricTotal(session.data.rubric_total)
              && scoreAggregatesUnchanged()
              && (
                fullyOlderPeriod
                  ? validOlderSessionAwardChanges()
                  : (
                    validCurrentSessionAwardChanges()
                    && validRubricSessionPeriodUpdate(createdAt)
                  )
              )
              && markerMatchesRubricSession(
                sessionId,
                session.data.rubric_total
              )
            )
            : (
              isScore(session.data.score)
              && request.resource.data.score_sum
                == resource.data.score_sum + session.data.score
              && averageMatches(
                request.resource.data.average_score,
                request.resource.data.sessions_completed,
                request.resource.data.score_sum
              )
              && request.resource.data.best_score
                == (
                  resource.data.best_score >= session.data.score
                    ? resource.data.best_score
                    : session.data.score
                )
              && (
                fullyOlderPeriod
                  ? validOlderSessionAwardChanges()
                  : (
                    validCurrentSessionAwardChanges()
                    && validSessionPeriodUpdate(session.data.score, createdAt)
                  )
              )
              && markerMatchesLegacySession(sessionId, session.data.score)
            )
        );
    }

    function validPublicProfileMetadataUpdate() {
      return resource.data.user_id == request.auth.uid
        && aggregatesUnchanged()
        && equippedBorderUnchanged()
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.display_name.size() <= 80
        && (!request.resource.data.keys().hasAny(['profile_picture_url'])
          || isValidHttpsProfilePictureUrl(request.resource.data.profile_picture_url));
    }

    // Equip / unequip cosmetic border only. Preserves every XP, session,
    // score, quest, and profile-metadata field.
    function validEquippedBorderUpdate() {
      let nextBorder = equippedBorderOf(request.resource.data);
      return resource.data.user_id == request.auth.uid
        && aggregatesUnchanged()
        && profilePictureUnchanged()
        && nextBorder is string
        && (
          nextBorder == ''
          || (
            isKnownProfileBorderId(nextBorder)
            && exists(userCosmeticsPath(request.auth.uid))
            && nextBorder in get(userCosmeticsPath(request.auth.uid)).data.unlocked_border_ids
          )
        );
    }

    // ---- Quest claim -> leaderboard update, replay-proof -------------------
    // A leaderboard write may only add quest_xp if it points (via
    // last_claim_id) at a daily_quest_claims document that:
    //   - did not exist before this request (!exists), and
    //   - exists after this request commits (existsAfter),
    // i.e. the claim must be freshly created atomically alongside this same
    // leaderboard write. Reusing an already-existing claim id (replay) fails
    // the !exists() check. The claim's own create rule (below) requires the
    // leaderboard-after state to point back at it, closing the loop in both
    // directions.
    function claimAfter(claimId) {
      return getAfter(claimPath(claimId)).data;
    }

    function leaderboardAfter(userId) {
      return getAfter(leaderboardPath(userId)).data;
    }

    // Single get() of the referenced board, reused for every board-derived
    // check below instead of calling get() repeatedly (stays comfortably
    // under the per-request get()/getAfter() budget).
    function claimReferencesOwnCurrentBoard(data) {
      let board = get(boardPath(data.board_id)).data;
      return board.user_id == request.auth.uid
        && board.day_key == data.day_key
        && board.day_start == data.day_start
        && data.quest_id in board.quest_ids;
    }

    function claimMatchesLeaderboardUpdate() {
      let claimId = request.resource.data.last_claim_id;
      // Deliberately no `let claim = claimAfter(claimId)` here: a `let`
      // binding evaluates eagerly, so it would call getAfter(...).data
      // (an evaluation error on a nonexistent document) before the
      // existsAfter() guard below has a chance to short-circuit. Repeating
      // claimAfter(claimId) inside the lazily-evaluated && chain instead
      // keeps every `.data` access gated behind existsAfter() first.
      return claimId is string
        && claimId != lastClaimIdOf(resource.data)
        && !exists(claimPath(claimId))
        && existsAfter(claimPath(claimId))
        && claimAfter(claimId).user_id == request.auth.uid
        && isKnownQuestId(claimAfter(claimId).quest_id)
        && claimAfter(claimId).day_key is string
        && claimAfter(claimId).day_key.matches('^[0-9]{8}$')
        && claimAfter(claimId).day_key == manilaDayKey(request.time)
        && claimAfter(claimId).xp_awarded == questXpFor(claimAfter(claimId).quest_id)
        && request.resource.data.quest_xp == questXpOf(resource.data) + claimAfter(claimId).xp_awarded;
    }

    function questAwardXp() {
      return claimAfter(request.resource.data.last_claim_id).xp_awarded;
    }

    function questAwardDayKey() {
      return claimAfter(request.resource.data.last_claim_id).day_key;
    }

    function questAwardMonthKey() {
      return manilaMonthKey(request.time);
    }

    function dailyQuestAggregateReset() {
      return request.resource.data.daily_key == questAwardDayKey()
        && request.resource.data.daily_xp == questAwardXp()
        && request.resource.data.daily_sessions_completed == 0
        && request.resource.data.daily_score_sum == 0
        && request.resource.data.daily_average_score == 0
        && request.resource.data.daily_best_score == 0;
    }

    function monthlyQuestAggregateReset() {
      return request.resource.data.monthly_key == questAwardMonthKey()
        && request.resource.data.monthly_xp == questAwardXp()
        && request.resource.data.monthly_sessions_completed == 0
        && request.resource.data.monthly_score_sum == 0
        && request.resource.data.monthly_average_score == 0
        && request.resource.data.monthly_best_score == 0;
    }

    function dailyQuestAggregateAccumulates() {
      return request.resource.data.daily_key == resource.data.daily_key
        && request.resource.data.daily_xp
          == resource.data.daily_xp + questAwardXp()
        && request.resource.data.daily_sessions_completed
          == resource.data.daily_sessions_completed
        && request.resource.data.daily_score_sum == resource.data.daily_score_sum
        && request.resource.data.daily_average_score
          == resource.data.daily_average_score
        && request.resource.data.daily_best_score == resource.data.daily_best_score;
    }

    function monthlyQuestAggregateAccumulates() {
      return request.resource.data.monthly_key == resource.data.monthly_key
        && request.resource.data.monthly_xp
          == resource.data.monthly_xp + questAwardXp()
        && request.resource.data.monthly_sessions_completed
          == resource.data.monthly_sessions_completed
        && request.resource.data.monthly_score_sum == resource.data.monthly_score_sum
        && request.resource.data.monthly_average_score
          == resource.data.monthly_average_score
        && request.resource.data.monthly_best_score == resource.data.monthly_best_score;
    }

    function validDailyQuestAggregateTransition() {
      let eventKey = questAwardDayKey();
      return (eventKey > resource.data.daily_key && dailyQuestAggregateReset())
        || (
          eventKey == resource.data.daily_key
          && dailyQuestAggregateAccumulates()
        )
        || (eventKey < resource.data.daily_key && dailyPeriodUnchanged());
    }

    function validMonthlyQuestAggregateTransition() {
      let eventKey = questAwardMonthKey();
      return (eventKey > resource.data.monthly_key && monthlyQuestAggregateReset())
        || (
          eventKey == resource.data.monthly_key
          && monthlyQuestAggregateAccumulates()
        )
        || (eventKey < resource.data.monthly_key && monthlyPeriodUnchanged());
    }

    function validQuestPeriodUpdate() {
      return (
          !resource.data.keys().hasAny(['daily_key'])
          && dailyQuestAggregateReset()
          && monthlyQuestAggregateReset()
        )
        || (
          resource.data.keys().hasAny(['daily_key'])
          && validDailyQuestAggregateTransition()
          && validMonthlyQuestAggregateTransition()
        );
    }

    function validQuestClaimUpdate() {
      return resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.sessions_completed == resource.data.sessions_completed
        && request.resource.data.score_sum == resource.data.score_sum
        && request.resource.data.average_score == resource.data.average_score
        && request.resource.data.best_score == resource.data.best_score
        && request.resource.data.last_awarded_session_id == resource.data.last_awarded_session_id
        && request.resource.data.last_session_at == resource.data.last_session_at
        && equippedBorderUnchanged()
        && request.resource.data.total_xp
           == request.resource.data.sessions_completed * 25 + questXpOf(request.resource.data)
        && claimMatchesLeaderboardUpdate()
        && validQuestPeriodUpdate();
    }

    // Teacher self-registration requires redeeming teacher_access_codes/{code}
    // in the same write. users.role remains a client-writable field.
    // TODO: Move Teacher role trust to a Firebase Auth custom claim set by a
    // Cloud Function after code redemption. This rules check is an interim
    // control, not the final authorization architecture.
    function teacherAccessCodePath(code) {
      return /databases/$(database)/documents/teacher_access_codes/$(code);
    }

    function isTeacherAccessCodeFormat(code) {
      return code is string
        && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$');
    }

    function teacherAccessCodeConsumedInSameWrite() {
      let code = request.resource.data.get('teacher_access_code', '');
      return request.resource.data.role == 'Teacher'
        && isTeacherAccessCodeFormat(code)
        && exists(teacherAccessCodePath(code))
        && get(teacherAccessCodePath(code)).data.consumed == false
        && existsAfter(teacherAccessCodePath(code))
        && getAfter(teacherAccessCodePath(code)).data.consumed == true
        && getAfter(teacherAccessCodePath(code)).data.consumed_by == request.auth.uid;
    }

    function validProfileName(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 80
        && value.matches('^\\S(?:.*\\S)?$');
    }

    function validOptionalMiddleName(data) {
      return !data.keys().hasAny(['middle_name'])
        || validProfileName(data.middle_name);
    }

    function validStructuredName(data) {
      return validProfileName(data.first_name)
        && validOptionalMiddleName(data)
        && validProfileName(data.last_name)
        && validProfileName(data.full_name)
        && (
          (
            data.keys().hasAny(['middle_name'])
            && data.full_name
              == data.first_name + ' ' + data.middle_name + ' ' + data.last_name
          )
          || (
            !data.keys().hasAny(['middle_name'])
            && data.full_name == data.first_name + ' ' + data.last_name
          )
        );
    }

    function validNewUserProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'first_name', 'middle_name', 'last_name', 'full_name', 'email',
          'role', 'teacher_access_code', 'created_at', 'privacy_consent_at',
          'privacy_policy_version', 'terms_consent_at',
          'terms_of_service_version', 'profile_picture_url',
          'profile_picture_storage_path'
        ])
        && validStructuredName(data)
        && data.email is string
        && request.auth.token.email is string
        && data.email == request.auth.token.email
        && data.role in ['Trainee', 'Teacher']
        && data.created_at == request.time
        && data.privacy_consent_at == request.time
        && data.privacy_policy_version == 'v6'
        && data.terms_consent_at == request.time
        && data.terms_of_service_version == 'v3';
    }

    function validUserProfileUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly([
          'first_name', 'middle_name', 'last_name', 'full_name', 'email',
          'profile_picture_path', 'profile_picture_url',
          'profile_picture_storage_path', 'session_evidence_enabled',
          'session_evidence_policy_version', 'session_evidence_decision_at',
          'teacher_roster_invite_code', 'teacher_invite_code'
        ])
        && (!affected.hasAny(['email'])
          || request.resource.data.email == request.auth.token.email)
        && (!affected.hasAny([
            'first_name', 'middle_name', 'last_name', 'full_name'
          ]) || validStructuredName(request.resource.data))
        && (!affected.hasAny([
            'session_evidence_enabled', 'session_evidence_policy_version',
            'session_evidence_decision_at'
          ]) || (
            request.resource.data.session_evidence_enabled is bool
            && request.resource.data.session_evidence_policy_version == 'v1'
            && request.resource.data.session_evidence_decision_at == request.time
          ));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && validNewUserProfile()
        && (
          request.resource.data.role == 'Trainee'
          || teacherAccessCodeConsumedInSameWrite()
        );
      allow update: if isOwner(userId) && validUserProfileUpdate();
      allow delete: if isOwner(userId);
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      // Assessment V2 sessions write rubric fields and omit `score`.
      // Legacy V1 documents remain readable; new creates require V2.
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && validRubricSession(request.resource.data)
        && isOfficialElixrMovementName(request.resource.data.movement_name)
        && validSessionEvidence(request.resource.data, sessionId)
        && request.resource.data.created_at is timestamp
        && request.resource.data.created_at == request.time
        && validSessionAssignmentContext(request.resource.data, sessionId);
      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && sessionIdentityUnchanged()
        && sessionEvidenceUnchangedOrRemoved()
        && (
          (
            resource.data.keys().hasAny(['score'])
            && request.resource.data.score == resource.data.score
          )
          || (
            resource.data.get('assessment_version', 1) == 2
            && request.resource.data.assessment_version
              == resource.data.assessment_version
            && request.resource.data.rubric_total == resource.data.rubric_total
            && request.resource.data.performance_level
              == resource.data.performance_level
            && request.resource.data.rubric.technique
              == resource.data.rubric.technique
            && request.resource.data.rubric.stability
              == resource.data.rubric.stability
            && request.resource.data.rubric.completion
              == resource.data.rubric.completion
            && request.resource.data.rubric.prop_positioning
              == resource.data.rubric.prop_positioning
          )
        );
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /training_plans/{planId} {
      allow get: if isSignedIn()
        && (
          (
            resource == null
            && planId.matches('^' + request.auth.uid + '_[0-9]{8}$')
          )
          || resource.data.user_id == request.auth.uid
        );
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && validTrainingPlanWrite(request.resource.data, planId)
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.day_key == resource.data.day_key
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && validTrainingPlanWrite(request.resource.data, planId);

      allow delete: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && isActionablePlanDayKey(resource.data.day_key);
    }

    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/sessions/$(resource.data.session_id)).data.user_id
          == request.auth.uid;
      // getAfter allows session + feedback writes in one batch (get() cannot see
      // the session document created in the same commit).
      allow create: if isSignedIn()
        && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)).data.user_id
          == request.auth.uid;
      // Self-erasure: parent session must still exist (same get() as read).
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/sessions/$(resource.data.session_id)).data.user_id
          == request.auth.uid;
    }

    // Public aggregate rankings. Authenticated read; own-document writes only.
    // Limitation: a modified client that still satisfies the XP-arithmetic
    // invariants (session award = +25/+1 session, quest claim = fixed
    // catalog XP backed by a freshly-created claim marker) can inflate its
    // own ranking faster than the intended pace, but cannot forge another
    // user's XP, replay a claim, or exceed the 5-quest/day catalog cap.
    // Suitable for a controlled capstone, not tamper-proof against a
    // hostile modified client.
    match /leaderboard/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && validLeaderboardShape(request.resource.data)
        && validSessionAwardCreate();

      allow update: if isOwner(userId)
        && (
          (
            request.resource.data.sessions_completed
              == resource.data.sessions_completed + 1
            && validSessionAwardUpdate()
          )
          || (
            validLeaderboardUpdateShape(request.resource.data)
            && (
              (
                questXpOf(request.resource.data) > questXpOf(resource.data)
                && validQuestClaimUpdate()
              )
              || validPublicProfileMetadataUpdate()
              || validEquippedBorderUpdate()
            )
          )
        );

      // Self-erasure only (RA 10173 account deletion).
      allow delete: if isOwner(userId);
    }

    match /leaderboard_processed_sessions/{sessionId} {
      // GET of a missing marker must succeed so the client transaction can
      // check idempotency before creating the first award. resource is null
      // when the document does not exist; accessing resource.data then fails
      // the whole rule and surfaces as cloud_firestore/unknown on Windows.
      allow get: if isSignedIn()
        && (resource == null || resource.data.user_id == request.auth.uid);

      // Queries must be constrained to the caller's own user_id.
      allow list: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.session_id == sessionId
        && request.resource.data.xp_awarded == 25
        && exists(sessionPath(sessionId))
        && sourceSession(sessionId).user_id == request.auth.uid
        && (
          (
            request.resource.data.keys().hasOnly(markerKeysV1())
            && isScore(request.resource.data.score)
            && sourceSession(sessionId).get('assessment_version', 1) != 2
            && request.resource.data.score == sourceSession(sessionId).score
          )
          || (
            request.resource.data.keys().hasOnly(markerKeysV2())
            && isRubricTotal(request.resource.data.rubric_total)
            && sourceSession(sessionId).get('assessment_version', 1) == 2
            && request.resource.data.rubric_total
              == sourceSession(sessionId).rubric_total
          )
        )
        && isOfficialElixrMovementName(sourceSession(sessionId).movement_name);

      allow update: if false;
      // Self-erasure only (RA 10173 account deletion).
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Persisted per-user, per-real-day quest board. Fully immutable after
    // creation (no update path at all), and the document id is forced to the
    // exact canonical value implied by the server clock at write time, so at
    // most one board can ever exist for a given user on a given real Manila
    // day — a second create attempt for the same real day collides with the
    // existing (unmodifiable) document instead of succeeding.
    match /daily_quest_boards/{boardId} {
      // Mirrors the leaderboard_processed_sessions missing-marker GET
      // pattern: resource is null for a not-yet-created own board, and that
      // must be readable so the client can decide whether to create it.
      allow get: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow list: if false; // only ever fetched by deterministic id, never queried

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(boardKeys())
        && request.resource.data.keys().hasAll(boardKeys())
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.day_key is string
        && request.resource.data.day_key.matches('^[0-9]{8}$')
        && request.resource.data.day_start is timestamp
        && request.resource.data.quest_ids is list
        && request.resource.data.quest_ids.size() == 5
        && request.resource.data.quest_ids.toSet().size() == 5
        && request.resource.data.quest_ids[0] in questCatalogIds()
        && request.resource.data.quest_ids[1] in questCatalogIds()
        && request.resource.data.quest_ids[2] in questCatalogIds()
        && request.resource.data.quest_ids[3] in questCatalogIds()
        && request.resource.data.quest_ids[4] in questCatalogIds()
        && countInSet(request.resource.data.quest_ids, sessionCountIds()) <= 1
        && countInSet(request.resource.data.quest_ids, durationIds()) <= 1
        && countInSet(request.resource.data.quest_ids, scoreThresholdIds()) <= 1
        && countInSet(request.resource.data.quest_ids, easyIds()) == 2
        && countInSet(request.resource.data.quest_ids, mediumIds()) == 2
        && countInSet(request.resource.data.quest_ids, hardIds()) == 1
        // Canonical-day anchoring: day_start/day_key must equal the exact
        // values implied by the server clock right now, AND the document id
        // itself (not just the stored fields) must equal the canonical
        // "<uid>_<today's Manila day key>" — this is what makes a second
        // board for the same real day structurally impossible rather than
        // merely usually-rejected.
        && request.resource.data.day_start == manilaDayStart(request.time)
        && request.resource.data.day_key == manilaDayKey(request.time)
        && boardId == request.auth.uid + '_' + manilaDayKey(request.time)
        && request.time >= request.resource.data.day_start
        && request.time < request.resource.data.day_start + duration.value(24, 'h');

      allow update: if false; // fully immutable after creation
      // Self-erasure only; list stays false (boards purged by deterministic id).
      // Missing docs: allow no-op delete only for the caller's canonical board
      // id (<uid>_<yyyyMMdd>). Existing docs still require resource.user_id.
      // resource == null is checked before resource.data (short-circuit safe).
      allow delete: if isCanonicalOwnDailyQuestBoardId(boardId)
        && (resource == null || resource.data.user_id == request.auth.uid);
    }

    // Idempotent, replay-proof quest-claim marker. Fully immutable after
    // creation. See claimMatchesLeaderboardUpdate() above for how this
    // collection and the leaderboard update reference each other atomically.
    match /daily_quest_claims/{claimId} {
      allow get: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(claimKeys())
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.quest_id is string
        && isKnownQuestId(request.resource.data.quest_id)
        && request.resource.data.xp_awarded == questXpFor(request.resource.data.quest_id)
        && request.resource.data.day_key is string
        && request.resource.data.day_start is timestamp
        && claimId == request.resource.data.user_id + '_' + request.resource.data.day_key + '_' + request.resource.data.quest_id
        && request.resource.data.board_id == request.auth.uid + '_' + manilaDayKey(request.time)
        && exists(boardPath(request.resource.data.board_id))
        && claimReferencesOwnCurrentBoard(request.resource.data)
        // Server-time-anchored real-day window: rejects claiming a stale
        // (already-ended) or not-yet-started board day regardless of any
        // client-supplied value, because request.time cannot be spoofed.
        && request.resource.data.day_start == manilaDayStart(request.time)
        && request.resource.data.day_key == manilaDayKey(request.time)
        && request.time >= request.resource.data.day_start
        && request.time < request.resource.data.day_start + duration.value(24, 'h')
        // Bidirectional link: this claim must correspond to the leaderboard
        // write happening atomically alongside it (rejects a "dangling"
        // claim created without ever bumping quest_xp).
        && leaderboardAfter(request.resource.data.user_id).last_claim_id == claimId;

      allow update: if false;
      // Self-erasure only (RA 10173 account deletion).
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Immutable achievement-claim markers. Atomic with user_cosmetics unlocks;
    // reward is fixed by catalog; completion is NOT server-verified.
    match /achievement_claims/{claimId} {
      allow get: if isSignedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow list: if isSignedIn() && resource.data.user_id == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(achievementClaimKeys())
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.achievement_id is string
        && isKnownAchievementId(request.resource.data.achievement_id)
        && request.resource.data.reward_border_id
          == rewardBorderForAchievement(request.resource.data.achievement_id)
        && claimId == request.resource.data.user_id + '_' + request.resource.data.achievement_id
        && request.resource.data.claimed_at == request.time
        && !exists(achievementClaimPath(claimId))
        && existsAfter(userCosmeticsPath(request.auth.uid))
        && getAfter(userCosmeticsPath(request.auth.uid)).data.last_achievement_claim_id == claimId
        && request.resource.data.reward_border_id
          in getAfter(userCosmeticsPath(request.auth.uid)).data.unlocked_border_ids;

      allow update: if false;
      // Self-erasure only (RA 10173 account deletion).
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // Private cosmetics inventory. Unlock only via atomic fresh achievement claim.
    match /user_cosmetics/{userId} {
      allow get: if isOwner(userId) && (resource == null || resource.data.user_id == userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(cosmeticsKeys())
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.unlocked_border_ids is list
        && request.resource.data.unlocked_border_ids.size() == 1
        && request.resource.data.unlocked_border_ids[0] is string
        && isKnownProfileBorderId(request.resource.data.unlocked_border_ids[0])
        && request.resource.data.last_achievement_claim_id is string
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && !exists(achievementClaimPath(request.resource.data.last_achievement_claim_id))
        && existsAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id))
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.user_id
          == request.auth.uid
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.achievement_id
          in achievementIds()
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.reward_border_id
          == request.resource.data.unlocked_border_ids[0]
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.reward_border_id
          == rewardBorderForAchievement(
            getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.achievement_id
          )
        && request.resource.data.last_achievement_claim_id
          == request.auth.uid + '_'
            + getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.achievement_id;

      allow update: if isOwner(userId)
        && resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly(cosmeticsKeys())
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && request.resource.data.unlocked_border_ids is list
        && resource.data.unlocked_border_ids is list
        && request.resource.data.unlocked_border_ids.size()
          == resource.data.unlocked_border_ids.size() + 1
        && request.resource.data.unlocked_border_ids.size() <= 10
        && oldBordersPreserved(
          resource.data.unlocked_border_ids,
          request.resource.data.unlocked_border_ids
        )
        && request.resource.data.last_achievement_claim_id is string
        && request.resource.data.last_achievement_claim_id
          != resource.data.last_achievement_claim_id
        && !exists(achievementClaimPath(request.resource.data.last_achievement_claim_id))
        && existsAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id))
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.user_id
          == request.auth.uid
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.reward_border_id
          == rewardBorderForAchievement(
            getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.achievement_id
          )
        && !(getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.reward_border_id
          in resource.data.unlocked_border_ids)
        && getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.reward_border_id
          in request.resource.data.unlocked_border_ids
        && request.resource.data.last_achievement_claim_id
          == request.auth.uid + '_'
            + getAfter(achievementClaimPath(request.resource.data.last_achievement_claim_id)).data.achievement_id;

      // Self-erasure only (RA 10173 account deletion).
      allow delete: if isOwner(userId);
    }

    // ---- Public profiles (privacy-aware player profile viewing) ------------
    function publicProfilePath(userId) {
      return /databases/$(database)/documents/public_profiles/$(userId);
    }

    function publicProfileRootKeys() {
      return [
        'user_id',
        'display_name',
        'profile_picture_url',
        'role',
        'visibility',
        'created_at',
        'updated_at',
        'schema_version'
      ];
    }

    function publicProfileSummaryKeys() {
      return [
        'total_duration_seconds',
        'completed_movement_names',
        'updated_at',
        'last_backfill_session_id'
      ];
    }

    function publicProfileSessionKeysV1() {
      return [
        'session_id',
        'user_id',
        'movement_name',
        'difficulty',
        'score',
        'duration_seconds',
        'prop_type',
        'created_at',
        'evidence_available'
      ];
    }

    function publicProfileSessionKeysV2() {
      return [
        'session_id',
        'user_id',
        'movement_name',
        'difficulty',
        'duration_seconds',
        'prop_type',
        'created_at',
        'assessment_version',
        'rubric',
        'rubric_total',
        'performance_level',
        'evidence_available'
      ];
    }

    function publicProfileAchievementKeys() {
      return [
        'user_id',
        'achievement_id',
        'claimed_at',
        'updated_at'
      ];
    }

    function profileVisitKeys() {
      return [
        'profile_owner_id',
        'viewer_id',
        'first_viewed_at',
        'last_viewed_at'
      ];
    }

    function publicProfileVisibility(userId) {
      return get(publicProfilePath(userId)).data.get('visibility', 'private');
    }

    function isPublicProfile(userId) {
      return publicProfileVisibility(userId) == 'public';
    }

    // Missing legacy roles are Trainee-compatible; unknown roles fail closed.
    function isOrdinaryPlayer() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', 'Trainee') == 'Trainee';
    }

    // Signed-in Trainee or Teacher. Missing legacy roles stay Trainee-compatible
    // via isOrdinaryPlayer(). Admin and unknown roles fail closed. Do not fold
    // Teachers into isOrdinaryPlayer(); that helper remains the Trainee social gate.
    function isProductParticipant() {
      return isOrdinaryPlayer()
        || (isSignedIn()
          && exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid)).data.get('role', 'Trainee')
            == 'Teacher');
    }

    function canReadProtectedPublicProfile(userId) {
      return isOwner(userId)
        || (isProductParticipant() && isPublicProfile(userId));
    }

    function validPublicProfileRoot(data, userId) {
      return data.keys().hasOnly(publicProfileRootKeys())
        && data.user_id == userId
        && data.display_name is string
        && data.display_name.size() > 0
        && data.display_name.size() <= 80
        && data.visibility in ['public', 'private']
        && (!data.keys().hasAny(['profile_picture_url'])
          || isValidHttpsProfilePictureUrl(data.profile_picture_url))
        && (!data.keys().hasAny(['role'])
          || (data.role is string
            && exists(userPath(userId))
            && get(userPath(userId)).data.role == data.role))
        && (!data.keys().hasAny(['schema_version'])
          || (data.schema_version is int && data.schema_version >= 1));
    }

    function validPublicProfileSummary(data) {
      return data.keys().hasOnly(publicProfileSummaryKeys())
        && isNonNegInt(data.total_duration_seconds)
        && data.completed_movement_names is list;
    }

    function validPublicProfileSession(data, userId, sessionId) {
      return data.session_id == sessionId
        && data.user_id == userId
        && data.movement_name is string
        && data.difficulty is string
        && isNonNegInt(data.duration_seconds)
        && data.prop_type is string
        && exists(sessionPath(sessionId))
        && get(sessionPath(sessionId)).data.user_id == userId
        && (!data.keys().hasAny(['evidence_available'])
          || (data.evidence_available == true
            && get(sessionPath(sessionId)).data.evidence_storage_path
              == 'users/' + userId + '/session_evidence/' + sessionId + '.jpg'
            && get(sessionPath(sessionId)).data.evidence_kind == 'hold_confirmed'))
        && (
          (
            data.keys().hasOnly(publicProfileSessionKeysV1())
            && isScore(data.score)
          )
          || (
            data.keys().hasOnly(publicProfileSessionKeysV2())
            && validRubricSession(data)
          )
        );
    }

    function validPublicProfileAchievement(data, userId, achievementId) {
      return data.keys().hasOnly(publicProfileAchievementKeys())
        && data.user_id == userId
        && data.achievement_id == achievementId
        && isKnownAchievementId(achievementId);
    }

    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && validPublicProfileRoot(request.resource.data, userId);
      allow update: if isOwner(userId)
        && validPublicProfileRoot(request.resource.data, userId)
        && request.resource.data.user_id == resource.data.user_id;
      allow delete: if isOwner(userId);

      match /details/summary {
        allow read: if isSignedIn()
          && (canReadProtectedPublicProfile(userId)
            || hasApprovedProgressAccess(userId)
            || hasApprovedClassroomProgressAccess(userId));
        allow create, update: if isOwner(userId)
          && validPublicProfileSummary(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isSignedIn()
          && (canReadProtectedPublicProfile(userId)
            || hasApprovedProgressAccess(userId)
            || hasApprovedClassroomProgressAccess(userId));
        allow create, update: if isOwner(userId)
          && validPublicProfileSession(request.resource.data, userId, sessionId);
        allow delete: if isOwner(userId);
      }

      match /achievements/{achievementId} {
        allow read: if isSignedIn() && canReadProtectedPublicProfile(userId);
        allow create, update: if isOwner(userId)
          && validPublicProfileAchievement(
            request.resource.data,
            userId,
            achievementId
          );
        allow delete: if isOwner(userId);
      }
    }

    match /profile_visits/{profileOwnerId}/visitors/{viewerId} {
      allow get: if isSignedIn()
        && (isOwner(profileOwnerId) || viewerId == request.auth.uid);
      // Single-collection list of inbound visitors for the profile owner.
      allow list: if isSignedIn() && isOwner(profileOwnerId);

      allow create: if isSignedIn()
        && viewerId == request.auth.uid
        && profileOwnerId != request.auth.uid
        && request.resource.data.keys().hasOnly(profileVisitKeys())
        && request.resource.data.keys().hasAll(profileVisitKeys())
        && request.resource.data.profile_owner_id == profileOwnerId
        && request.resource.data.viewer_id == viewerId;

      allow update: if isSignedIn()
        && viewerId == request.auth.uid
        && profileOwnerId != request.auth.uid
        && request.resource.data.keys().hasOnly(profileVisitKeys())
        && request.resource.data.profile_owner_id == profileOwnerId
        && request.resource.data.viewer_id == viewerId
        && request.resource.data.first_viewed_at == resource.data.first_viewed_at;

      // Self-erasure: profile owner wiping inbound visits, or viewer wiping outbound rows.
      allow delete: if isSignedIn()
        && (isOwner(profileOwnerId) || viewerId == request.auth.uid);
    }

    // Collection-group list of outbound visit rows for account erasure.
    // Requires rules_version = '2' recursive wildcard (see Firebase docs).
    match /{path=**}/visitors/{viewerId} {
      allow list: if isSignedIn()
        && resource.data.viewer_id == request.auth.uid;
    }

    // ---- Teacher ↔ Trainee roster (Phase 2A) -------------------------------
    // Relationship authorization is independent of the self-declared
    // users.role field. Coach codes are bearer tokens (exact get only).
    // email_verified comes from the ID token, not User.emailVerified.
    // Clients must force-refresh the token after email verification.
    function hasVerifiedEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email_verified == true;
    }

    function isNormalizedCoachCode(code) {
      return code is string
        && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{12}$');
    }

    function isDisplayName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 80;
    }

    function isParticipantId(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 128;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/teacher_invites/$(code);
    }

    function userFullName(userId) {
      return get(userPath(userId)).data.full_name;
    }

    function inviteKeys() {
      return ['teacher_id', 'teacher_display_name', 'created_at'];
    }

    function validInviteCreate(data, inviteId) {
      return hasVerifiedEmail()
        && isNormalizedCoachCode(inviteId)
        && !exists(groupInvitePath(inviteId))
        && data.keys().hasOnly(inviteKeys())
        && data.teacher_id == request.auth.uid
        && isParticipantId(data.teacher_id)
        && isDisplayName(data.teacher_display_name)
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', '') == 'Teacher'
        && data.teacher_display_name == userFullName(request.auth.uid)
        && getAfter(userPath(request.auth.uid)).data.teacher_roster_invite_code
          == inviteId
        && data.created_at == request.time;
    }

    function linkKeys() {
      return [
        'teacher_id',
        'trainee_id',
        'teacher_display_name',
        'trainee_display_name',
        'status',
        'invite_id',
        'created_at',
        'updated_at'
      ];
    }

    function linkAllowedKeys() {
      return linkKeys().concat([
        'request_version',
        'progress_access',
        'progress_access_version',
        'progress_access_granted_at'
      ]).concat([
        'evidence_access',
        'evidence_access_version',
        'evidence_access_granted_at'
      ]);
    }

    function progressAccessIsNone(data) {
      return data.get('progress_access', 'none') == 'none'
        && !data.keys().hasAny([
          'progress_access_version', 'progress_access_granted_at'
        ]);
    }

    function validProgressAccessShape(data) {
      return progressAccessIsNone(data)
        || (data.keys().hasAll([
            'progress_access',
            'progress_access_version',
            'progress_access_granted_at'
          ])
          && data.progress_access == 'granted'
          && data.progress_access_version == 1
          && data.progress_access_granted_at is timestamp);
    }

    function evidenceAccessIsNone(data) {
      return !data.keys().hasAny([
        'evidence_access',
        'evidence_access_version',
        'evidence_access_granted_at'
      ]);
    }

    function validEvidenceAccessShape(data) {
      return evidenceAccessIsNone(data)
        || (data.keys().hasAll([
            'evidence_access',
            'evidence_access_version',
            'evidence_access_granted_at'
          ])
          && data.evidence_access == 'granted'
          && data.evidence_access_version == 1
          && data.evidence_access_granted_at is timestamp);
    }

    function teacherStudentLinkPath(teacherId, traineeId) {
      return /databases/$(database)/documents/teacher_student_links/$(teacherId + '_' + traineeId);
    }

    function classroomTeacherAccessPath(teacherId, traineeId) {
      return /databases/$(database)/documents/classroom_teacher_access/$(teacherId + '_' + traineeId);
    }

    function hasApprovedProgressAccess(traineeId) {
      return isSignedIn()
        && exists(teacherStudentLinkPath(request.auth.uid, traineeId))
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.teacher_id
          == request.auth.uid
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.trainee_id
          == traineeId
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.status
          == 'approved'
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.progress_access
          == 'granted'
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.progress_access_version
          == 1
        && get(teacherStudentLinkPath(request.auth.uid, traineeId)).data.progress_access_granted_at
          is timestamp;
    }

    // The context is a repairable pointer. Protected reads must still verify
    // the current Teacher-owned group and approved membership through
    // hasClassroomAuthorization().
    function hasApprovedClassroomProgressAccess(traineeId) {
      let contextRef = classroomTeacherAccessPath(request.auth.uid, traineeId);
      return isSignedIn()
        && exists(contextRef)
        && get(contextRef).data.get('teacher_id', '') == request.auth.uid
        && get(contextRef).data.get('trainee_id', '') == traineeId
        && get(contextRef).data.get('group_id', '') is string
        && get(contextRef).data.get('schema_version', 0) == 1
        && hasClassroomAuthorization(
          get(contextRef).data.group_id,
          traineeId
        );
    }

    function isLinkParticipant() {
      return isSignedIn()
        && (
          resource.data.teacher_id == request.auth.uid
          || resource.data.trainee_id == request.auth.uid
        );
    }

    function linkIdsMatchDocument(data, linkId) {
      return isParticipantId(data.teacher_id)
        && isParticipantId(data.trainee_id)
        && data.teacher_id != data.trainee_id
        && linkId == data.teacher_id + '_' + data.trainee_id;
    }

    function liveInviteMatchesTeacher(data) {
      return isNormalizedCoachCode(data.invite_id)
        && exists(invitePath(data.invite_id))
        && exists(userPath(data.teacher_id))
        && get(invitePath(data.invite_id)).data.teacher_id == data.teacher_id
        && get(userPath(data.teacher_id)).data.get(
          'teacher_roster_invite_code', ''
        ) == data.invite_id
        && data.teacher_display_name
          == get(invitePath(data.invite_id)).data.teacher_display_name;
    }

    function validPendingLinkCreate(data, linkId) {
      return isSignedIn()
        && data.keys().hasOnly(linkAllowedKeys())
        && data.trainee_id == request.auth.uid
        && data.status == 'pending'
        && data.request_version == 2
        && progressAccessIsNone(data)
        && evidenceAccessIsNone(data)
        && linkIdsMatchDocument(data, linkId)
        && isDisplayName(data.teacher_display_name)
        && isDisplayName(data.trainee_display_name)
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', '') == 'Trainee'
        && data.trainee_display_name == userFullName(request.auth.uid)
        && liveInviteMatchesTeacher(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function linkParticipantsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'teacher_id', 'trainee_id', 'created_at'
      ]);
    }

    function linkIdentitySnapshotsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'teacher_display_name', 'trainee_display_name', 'invite_id',
        'request_version'
      ]);
    }

    function validLinkUpdateShape(data) {
      return data.keys().hasOnly(linkAllowedKeys())
        && data.keys().hasAll(linkKeys())
        && data.status in ['pending', 'approved', 'rejected', 'cancelled', 'revoked']
        && data.updated_at == request.time
        && validProgressAccessShape(data)
        && validEvidenceAccessShape(data);
    }

    function validTraineeLinkTransition(linkId) {
      return resource.data.trainee_id == request.auth.uid
        && linkParticipantsUnchanged()
        && (
          (resource.data.status == 'approved'
            && request.resource.data.status == 'approved'
            && linkIdentitySnapshotsUnchanged()
            && ((progressAccessIsNone(resource.data)
                && request.resource.data.progress_access == 'granted'
                && request.resource.data.progress_access_version == 1
                && request.resource.data.progress_access_granted_at == request.time
                && evidenceAccessIsNone(request.resource.data))
              || (resource.data.progress_access == 'granted'
                && progressAccessIsNone(request.resource.data)
                && evidenceAccessIsNone(request.resource.data))
              || (resource.data.progress_access == 'granted'
                && request.resource.data.progress_access == 'granted'
                && resource.data.progress_access_version
                  == request.resource.data.progress_access_version
                && resource.data.progress_access_granted_at
                  == request.resource.data.progress_access_granted_at
                && ((evidenceAccessIsNone(resource.data)
                    && request.resource.data.evidence_access == 'granted'
                    && request.resource.data.evidence_access_version == 1
                    && request.resource.data.evidence_access_granted_at == request.time)
                  || (resource.data.evidence_access == 'granted'
                    && evidenceAccessIsNone(request.resource.data))))))
          || (resource.data.status == 'pending'
            && resource.data.get('request_version', 0) == 2
            && request.resource.data.status == 'cancelled'
            && linkIdentitySnapshotsUnchanged()
            && progressAccessIsNone(request.resource.data)
            && evidenceAccessIsNone(request.resource.data))
          || (resource.data.status == 'approved'
            && request.resource.data.status == 'revoked'
            && linkIdentitySnapshotsUnchanged()
            && progressAccessIsNone(request.resource.data)
            && evidenceAccessIsNone(request.resource.data))
          || (resource.data.status != 'approved'
            && (resource.data.status != 'pending'
              || resource.data.get('request_version', 0) != 2)
            && request.resource.data.status == 'pending'
            && request.resource.data.request_version == 2
            && linkParticipantsUnchanged()
            && linkIdsMatchDocument(request.resource.data, linkId)
            && isDisplayName(request.resource.data.teacher_display_name)
            && isDisplayName(request.resource.data.trainee_display_name)
            && get(userPath(request.auth.uid)).data.get('role', '') == 'Trainee'
            && request.resource.data.trainee_display_name
              == userFullName(request.auth.uid)
            && liveInviteMatchesTeacher(request.resource.data)
            && progressAccessIsNone(request.resource.data)
            && evidenceAccessIsNone(request.resource.data))
        )
        ;
    }

    function validTeacherDecisionTransition() {
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && resource.data.status == 'pending'
        && resource.data.get('request_version', 0) == 2
        && request.resource.data.status in ['approved', 'rejected']
        && linkParticipantsUnchanged()
        && linkIdentitySnapshotsUnchanged()
        && progressAccessIsNone(request.resource.data)
        && evidenceAccessIsNone(request.resource.data);
    }

    match /teacher_invites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn() && validInviteCreate(request.resource.data, inviteId);
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource == null
          || resource.data.get('teacher_id', '') == request.auth.uid
          || resource.data.get('trainee_id', '') == request.auth.uid);
    }

    // Access-code contents are private. Registration performs authoritative
    // validation only after Firebase authentication.
    function validTeacherAccessCodeMint(data, code) {
      return isVerifiedTeacher()
        && isNormalizedCoachCode(code)
        && data.consumed == false
        && data.created_by == request.auth.uid
        && data.created_at == request.time
        && data.keys().hasOnly(['consumed', 'created_at', 'created_by', 'note'])
        && (
          !data.keys().hasAny(['note'])
          || (data.note is string && data.note.size() <= 200)
        );
    }

    function validTeacherAccessCodeConsume(code) {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && isNormalizedCoachCode(code)
        && resource.data.consumed == false
        && request.resource.data.consumed == true
        && request.resource.data.consumed_by == request.auth.uid
        && request.resource.data.consumed_at == request.time
        && affected.hasOnly(['consumed', 'consumed_by', 'consumed_at'])
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'Teacher'
        && getAfter(userPath(request.auth.uid)).data.teacher_access_code == code;
    }

    function validTeacherAccessCodeAnonymization() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let ownsCreatorData = resource.data.get('created_by', '') == request.auth.uid;
      let ownsConsumerData = resource.data.get('consumed_by', '') == request.auth.uid;
      return isSignedIn()
        && resource.data.consumed == true
        && request.resource.data.consumed == true
        && request.resource.data.consumed_at == resource.data.consumed_at
        && (ownsCreatorData || ownsConsumerData)
        && affected.hasOnly(['created_by', 'consumed_by', 'note'])
        && (!affected.hasAny(['created_by', 'note']) || ownsCreatorData)
        && (!affected.hasAny(['consumed_by']) || ownsConsumerData)
        && (!ownsCreatorData
          || !request.resource.data.keys().hasAny(['created_by', 'note']))
        && (!ownsConsumerData
          || !request.resource.data.keys().hasAny(['consumed_by']));
    }

    match /teacher_access_codes/{code} {
      allow get: if isSignedIn() && isTeacherAccessCodeFormat(code);
      allow list: if isSignedIn()
        && resource.data.get('created_by', '') == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.get('consumed_by', '') == request.auth.uid;
      allow create: if validTeacherAccessCodeMint(request.resource.data, code);
      allow update: if validTeacherAccessCodeConsume(code)
        || validTeacherAccessCodeAnonymization();
      allow delete: if isSignedIn()
        && resource.data.consumed == false
        && resource.data.created_by == request.auth.uid;
    }

    match /teacher_student_links/{linkId} {
      allow get: if isLinkParticipant();
      // Split OR into separate allows so queries constrained to teacher_id or
      // trainee_id can be proven by the rules engine.
      allow list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.trainee_id == request.auth.uid;

      allow create: if validPendingLinkCreate(request.resource.data, linkId);

      allow update: if isSignedIn()
        && validLinkUpdateShape(request.resource.data)
        && (
          validTraineeLinkTransition(linkId)
          || validTeacherDecisionTransition()
        );

      // Participant delete supports account erasure; UI does not delete
      // approved history (Trainee revoke uses status instead).
      allow delete: if isSignedIn()
        && (resource == null || isLinkParticipant());
    }

    // Private, repairable classroom authorization pointers. The pointer is
    // never sufficient by itself: protected readers re-check the group and
    // membership, and writes must bind all ids to the authenticated Teacher.
    function classroomAccessContextKeys() {
      return [
        'teacher_id',
        'trainee_id',
        'group_id',
        'schema_version',
        'updated_at'
      ];
    }

    function classroomAccessContextIdsMatch(data, contextId) {
      return data.teacher_id is string
        && data.trainee_id is string
        && data.group_id is string
        && isParticipantId(data.teacher_id)
        && isParticipantId(data.trainee_id)
        && isParticipantId(data.group_id)
        && data.teacher_id != data.trainee_id
        && contextId == data.teacher_id + '_' + data.trainee_id;
    }

    function validClassroomAccessContextWrite(data, contextId) {
      return isVerifiedTeacher()
        && data.keys().hasOnly(classroomAccessContextKeys())
        && classroomAccessContextIdsMatch(data, contextId)
        && data.teacher_id == request.auth.uid
        && data.schema_version == 1
        && data.updated_at == request.time
        && existsAfter(groupPath(data.group_id))
        && getAfter(groupPath(data.group_id)).data.teacher_id == request.auth.uid
        && existsAfter(groupMembershipPath(data.group_id, data.trainee_id))
        && getAfter(groupMembershipPath(data.group_id, data.trainee_id)).data.group_id
          == data.group_id
        && getAfter(groupMembershipPath(data.group_id, data.trainee_id)).data.teacher_id
          == data.teacher_id
        && getAfter(groupMembershipPath(data.group_id, data.trainee_id)).data.trainee_id
          == data.trainee_id
        && getAfter(groupMembershipPath(data.group_id, data.trainee_id)).data.status
          == 'approved';
    }

    match /classroom_teacher_access/{contextId} {
      allow get: if isSignedIn()
        && (resource.data.teacher_id == request.auth.uid
          || resource.data.trainee_id == request.auth.uid);
      allow list: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.trainee_id == request.auth.uid;
      allow create: if validClassroomAccessContextWrite(
        request.resource.data,
        contextId
      );
      allow update: if validClassroomAccessContextWrite(
        request.resource.data,
        contextId
      );
      allow delete: if isSignedIn()
        && (resource.data.teacher_id == request.auth.uid
          || resource.data.trainee_id == request.auth.uid);
    }

    // ---- Teacher-owned groups (Phase 2) ------------------------------------
    // Classroom Authorization = approved group_memberships plus a repairable
    // classroom_teacher_access pointer for protected progress/evidence reads.
    // Legacy Progress Access / General Evidence Access remain on
    // teacher_student_links for legacy-only relationships.
    // Assignment Submission Authorization is not implemented until Phase 6.

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupInvitePath(code) {
      return /databases/$(database)/documents/group_invites/$(code);
    }

    function groupMembershipPath(groupId, traineeId) {
      return /databases/$(database)/documents/group_memberships/$(groupId + '_' + traineeId);
    }

    function groupKeys() {
      return [
        'teacher_id',
        'name',
        'status',
        'created_at',
        'updated_at',
        'schema_version'
      ];
    }

    function groupAllowedKeys() {
      return groupKeys().concat([
        'invite_code', 'section', 'schedule', 'pinned_announcement_id',
        'pinned_announcement_at'
      ]);
    }

    function isVerifiedTeacher() {
      return hasVerifiedEmail()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', '') == 'Teacher';
    }

    // Trainees may observe only the lifecycle status of classrooms where they
    // hold an approved membership. The status projection contains no group
    // metadata, so archived classroom data remains protected by the group
    // document's active-only GET rule.
    function isApprovedTraineeForGroup(groupId) {
      let membershipRef = groupMembershipPath(groupId, request.auth.uid);
      return isSignedIn()
        && exists(groupPath(groupId))
        && exists(membershipRef)
        && get(membershipRef).data.group_id == groupId
        && get(membershipRef).data.trainee_id == request.auth.uid
        && get(membershipRef).data.status == 'approved'
        && get(groupPath(groupId)).data.teacher_id
          == get(membershipRef).data.teacher_id;
    }

    function classroomStatusPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/lifecycle/status;
    }

    function isGroupTeacher(groupId) {
      return isVerifiedTeacher()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.teacher_id == request.auth.uid;
    }

    function isAccountDeletionInProgress() {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get(
          'lifecycle_state', 'active'
        ) == 'deleting';
    }

    function validClassroomStatusWrite(groupId) {
      let groupAfter = getAfter(groupPath(groupId));
      return isVerifiedTeacher()
        && groupAfter != null
        && groupAfter.data.teacher_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'updated_at'])
        && request.resource.data.keys().hasAll(['status', 'updated_at'])
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.status == groupAfter.data.status
        && request.resource.data.updated_at == request.time;
    }

    function classroomStatusMatchesAfter(groupId) {
      let statusAfter = getAfter(classroomStatusPath(groupId));
      return statusAfter != null
        && statusAfter.data.status == request.resource.data.status
        && statusAfter.data.updated_at == request.time;
    }

    function validGroupCreate(data) {
      return isVerifiedTeacher()
        && data.keys().hasOnly(groupAllowedKeys())
        && data.teacher_id == request.auth.uid
        && isParticipantId(data.teacher_id)
        && isDisplayName(data.name)
        && data.status == 'active'
        && data.schema_version == 2
        && !data.keys().hasAny([
          'pinned_announcement_id', 'pinned_announcement_at'
        ])
        && (!data.keys().hasAny(['section'])
          || isBoundedText(data.section, 80))
        && (!data.keys().hasAny(['schedule'])
          || isBoundedText(data.schedule, 120))
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function validGroupInvitePointerUpdate(groupId) {
      let newCode = request.resource.data.invite_code;
      let inviteAfter = getAfter(groupInvitePath(newCode));
      return resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && request.resource.data.name == resource.data.name
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.created_at == resource.data.created_at
        && (
          request.resource.data.schema_version == resource.data.schema_version
          || (
            resource.data.schema_version == 1
            && request.resource.data.schema_version == 2
          )
        )
        && request.resource.data.updated_at == request.time
        && isNormalizedCoachCode(newCode)
        && inviteAfter != null
        && inviteAfter.data.group_id == groupId
        && inviteAfter.data.teacher_id == request.auth.uid
        && inviteAfter.data.teacher_display_name == userFullName(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'invite_code', 'updated_at'
        ]);
    }

    function validGroupTeacherUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && request.resource.data.keys().hasOnly(groupAllowedKeys())
        && request.resource.data.keys().hasAll(groupKeys())
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.created_at == resource.data.created_at
        && (
          request.resource.data.schema_version == resource.data.schema_version
          || (
            resource.data.schema_version == 1
            && request.resource.data.schema_version == 2
          )
        )
        && request.resource.data.status in ['active', 'archived']
        && isDisplayName(request.resource.data.name)
        && (!request.resource.data.keys().hasAny(['section'])
          || isBoundedText(request.resource.data.section, 80))
        && (!request.resource.data.keys().hasAny(['schedule'])
          || isBoundedText(request.resource.data.schedule, 120))
        && request.resource.data.updated_at == request.time
        && (
          changed.hasOnly([
            'name', 'section', 'schedule', 'schema_version', 'updated_at'
          ])
          || (
            changed.hasOnly(['status', 'updated_at'])
            && (
              (resource.data.status == 'active'
                && request.resource.data.status == 'archived')
              || (resource.data.status == 'archived'
                && request.resource.data.status in ['archived', 'active'])
            )
            && (
              !exists(classroomStatusPath(groupId))
              || classroomStatusMatchesAfter(groupId)
            )
          )
          || validGroupInvitePointerUpdate(groupId)
          || validGroupAnnouncementPinUpdate(groupId)
        );
    }

    function announcementPath(groupId, announcementId) {
      return /databases/$(database)/documents/groups/$(groupId)/announcements/$(announcementId);
    }

    function validGroupAnnouncementPinUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let hasPinnedId = request.resource.data.keys().hasAny([
        'pinned_announcement_id'
      ]);
      let hasPinnedAt = request.resource.data.keys().hasAny([
        'pinned_announcement_at'
      ]);
      let pinnedId = request.resource.data.get('pinned_announcement_id', '');
      return changed.hasOnly([
          'pinned_announcement_id', 'pinned_announcement_at', 'updated_at'
        ])
        && request.resource.data.updated_at == request.time
        && (
          (!hasPinnedId && !hasPinnedAt)
          || (
            resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && hasPinnedId
            && hasPinnedAt
            && isParticipantId(pinnedId)
            && request.resource.data.pinned_announcement_at == request.time
            && existsAfter(announcementPath(groupId, pinnedId))
            && getAfter(announcementPath(groupId, pinnedId)).data.group_id
              == groupId
            && getAfter(announcementPath(groupId, pinnedId)).data.teacher_id
              == request.auth.uid
            && (
              !getAfter(announcementPath(groupId, pinnedId)).data.keys()
                .hasAny(['publish_at'])
              || getAfter(announcementPath(groupId, pinnedId)).data.publish_at
                <= request.time
            )
          )
        );
    }

    function groupInviteKeys() {
      return ['group_id', 'teacher_id', 'teacher_display_name', 'created_at'];
    }

    function liveGroupInviteMatchesOwner(data) {
      return isNormalizedCoachCode(data.invite_id)
        && exists(groupInvitePath(data.invite_id))
        && exists(groupPath(data.group_id))
        && get(groupInvitePath(data.invite_id)).data.group_id == data.group_id
        && get(groupInvitePath(data.invite_id)).data.teacher_id == data.teacher_id
        && get(groupPath(data.group_id)).data.teacher_id == data.teacher_id
        && get(groupPath(data.group_id)).data.status == 'active'
        && get(groupPath(data.group_id)).data.get('invite_code', '')
          == data.invite_id
        && data.teacher_display_name
          == get(groupInvitePath(data.invite_id)).data.teacher_display_name;
    }

    function validGroupInviteCreate(data, inviteId) {
      return isVerifiedTeacher()
        && isNormalizedCoachCode(inviteId)
        && !exists(invitePath(inviteId))
        && data.keys().hasOnly(groupInviteKeys())
        && data.teacher_id == request.auth.uid
        && isParticipantId(data.teacher_id)
        && isParticipantId(data.group_id)
        && isDisplayName(data.teacher_display_name)
        && exists(groupPath(data.group_id))
        && get(groupPath(data.group_id)).data.teacher_id == request.auth.uid
        && get(groupPath(data.group_id)).data.status == 'active'
        && data.teacher_display_name == userFullName(request.auth.uid)
        && data.created_at == request.time
        && getAfter(groupPath(data.group_id)).data.get('invite_code', '') == inviteId;
    }

    function membershipKeys() {
      return [
        'group_id',
        'teacher_id',
        'trainee_id',
        'teacher_display_name',
        'trainee_display_name',
        'status',
        'invite_id',
        'created_at',
        'updated_at'
      ];
    }

    function membershipAllowedKeys() {
      return membershipKeys().concat(['request_version']);
    }

    function membershipIdsMatchDocument(data, membershipId) {
      return isParticipantId(data.group_id)
        && isParticipantId(data.teacher_id)
        && isParticipantId(data.trainee_id)
        && data.teacher_id != data.trainee_id
        && membershipId == data.group_id + '_' + data.trainee_id;
    }

    function isMembershipParticipant() {
      return isSignedIn()
        && (
          resource.data.teacher_id == request.auth.uid
          || resource.data.trainee_id == request.auth.uid
        );
    }

    // Approved classmates may list other approved members in the same group.
    // Pending, rejected, cancelled, and removed rows stay hidden from peers.
    // Clients must query teacher_id + group_id + status==approved so Cloud
    // Firestore can prove every result passes this rule.
    function hasApprovedMembershipInSameGroup() {
      return isSignedIn()
        && resource.data.status == 'approved'
        && isParticipantId(resource.data.group_id)
        && exists(groupMembershipPath(resource.data.group_id, request.auth.uid))
        && get(groupMembershipPath(resource.data.group_id, request.auth.uid)).data.group_id
          == resource.data.group_id
        && get(groupMembershipPath(resource.data.group_id, request.auth.uid)).data.trainee_id
          == request.auth.uid
        && get(groupMembershipPath(resource.data.group_id, request.auth.uid)).data.status
          == 'approved'
        && get(groupMembershipPath(resource.data.group_id, request.auth.uid)).data.teacher_id
          == resource.data.teacher_id;
    }

    // Binds authorization to the authenticated Teacher viewer (Phase 3+).
    function hasClassroomAuthorization(groupId, traineeId) {
      return isSignedIn()
        && exists(groupPath(groupId))
        && request.auth.uid == get(groupPath(groupId)).data.teacher_id
        && exists(groupMembershipPath(groupId, traineeId))
        && get(groupMembershipPath(groupId, traineeId)).data.group_id == groupId
        && get(groupMembershipPath(groupId, traineeId)).data.trainee_id
          == traineeId
        && get(groupMembershipPath(groupId, traineeId)).data.teacher_id
          == request.auth.uid
        && get(groupMembershipPath(groupId, traineeId)).data.status == 'approved';
    }

    function validPendingMembershipCreate(data, membershipId) {
      return isSignedIn()
        && data.keys().hasOnly(membershipAllowedKeys())
        && data.trainee_id == request.auth.uid
        && data.status == 'pending'
        && data.request_version == 1
        && membershipIdsMatchDocument(data, membershipId)
        && isDisplayName(data.teacher_display_name)
        && isDisplayName(data.trainee_display_name)
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('role', '') == 'Trainee'
        && data.trainee_display_name == userFullName(request.auth.uid)
        && liveGroupInviteMatchesOwner(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function membershipParticipantsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'group_id', 'teacher_id', 'trainee_id', 'created_at'
      ]);
    }

    function membershipIdentitySnapshotsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'teacher_display_name', 'trainee_display_name', 'invite_id',
        'request_version'
      ]);
    }

    function classroomAccessContextAfterMembership(data) {
      let contextRef = classroomTeacherAccessPath(
        data.teacher_id,
        data.trainee_id
      );
      return existsAfter(contextRef)
        && getAfter(contextRef).data.teacher_id == data.teacher_id
        && getAfter(contextRef).data.trainee_id == data.trainee_id
        && getAfter(contextRef).data.group_id == data.group_id
        && getAfter(contextRef).data.schema_version == 1
        && getAfter(contextRef).data.updated_at == request.time;
    }

    function validMembershipUpdateShape(data) {
      return data.keys().hasOnly(membershipAllowedKeys())
        && data.keys().hasAll(membershipKeys())
        && data.status in ['pending', 'approved', 'rejected', 'cancelled', 'removed']
        && data.updated_at == request.time;
    }

    function validTraineeMembershipTransition(membershipId) {
      return resource.data.trainee_id == request.auth.uid
        && membershipParticipantsUnchanged()
        && (
          (resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && membershipIdentitySnapshotsUnchanged())
          || (resource.data.status == 'approved'
            && request.resource.data.status == 'removed'
            && membershipIdentitySnapshotsUnchanged())
          || (resource.data.status != 'approved'
            && (resource.data.status != 'pending'
              || resource.data.get('request_version', 0) != 1)
            && request.resource.data.status == 'pending'
            && request.resource.data.request_version == 1
            && membershipIdsMatchDocument(request.resource.data, membershipId)
            && isDisplayName(request.resource.data.teacher_display_name)
            && isDisplayName(request.resource.data.trainee_display_name)
            && get(userPath(request.auth.uid)).data.get('role', '') == 'Trainee'
            && request.resource.data.trainee_display_name
              == userFullName(request.auth.uid)
            && liveGroupInviteMatchesOwner(request.resource.data))
        );
    }

    function validTeacherMembershipDecision() {
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && resource.data.status == 'pending'
        && resource.data.get('request_version', 0) == 1
        && request.resource.data.status in ['approved', 'rejected']
        && membershipParticipantsUnchanged()
        && membershipIdentitySnapshotsUnchanged()
        && (
          request.resource.data.status == 'rejected'
          || classroomAccessContextAfterMembership(request.resource.data)
        );
    }

    function validTeacherMembershipRemoval() {
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && resource.data.status == 'approved'
        && request.resource.data.status == 'removed'
        && membershipParticipantsUnchanged()
        && membershipIdentitySnapshotsUnchanged();
    }

    match /groups/{groupId} {
      allow get: if isSignedIn()
        && (resource.data.status == 'active'
          || resource.data.teacher_id == request.auth.uid);
      allow list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;

      allow create: if validGroupCreate(request.resource.data);

      allow update: if validGroupTeacherUpdate(groupId);

      allow delete: if isSignedIn()
        && resource != null
        && resource.data.teacher_id == request.auth.uid
        && (
          !exists(userPath(request.auth.uid))
          || get(userPath(request.auth.uid)).data.get('lifecycle_state', 'active')
            == 'deleting'
        );
    }

    // Classroom announcements are group-scoped broadcasts. Their audience is
    // intentionally dynamic: an approved current member can read the class
    // history, while a removed member loses access immediately.
    function announcementKeys() {
      return [
        'group_id', 'teacher_id', 'title', 'body', 'created_at', 'edited_at',
        'schema_version', 'publish_at'
      ];
    }

    function validAnnouncementText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength
        && value.matches('.*[^[:space:]].*');
    }

    function isApprovedAnnouncementMember(groupId) {
      let membershipRef = groupMembershipPath(groupId, request.auth.uid);
      return isSignedIn()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.status == 'active'
        && exists(membershipRef)
        && get(membershipRef).data.group_id == groupId
        && get(membershipRef).data.trainee_id == request.auth.uid
        && get(membershipRef).data.status == 'approved'
        && get(membershipRef).data.teacher_id
          == get(groupPath(groupId)).data.teacher_id;
    }

    function isAnnouncementOwner(groupId) {
      return isVerifiedTeacher()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.teacher_id == request.auth.uid;
    }

    function validAnnouncementCreate(data, groupId) {
      return isAnnouncementOwner(groupId)
        && get(groupPath(groupId)).data.status == 'active'
        && data.keys().hasOnly(announcementKeys())
        && data.group_id == groupId
        && isParticipantId(data.group_id)
        && isParticipantId(data.teacher_id)
        && data.teacher_id == request.auth.uid
        && validAnnouncementText(data.title, 120)
        && validAnnouncementText(data.body, 2000)
        && data.created_at == request.time
        && data.edited_at == null
        && (!data.keys().hasAny(['publish_at'])
          || (data.publish_at is timestamp && data.publish_at > request.time))
        && data.schema_version == 1;
    }

    function validAnnouncementUpdate(groupId) {
      let before = resource.data;
      let after = request.resource.data;
      return isAnnouncementOwner(groupId)
        && get(groupPath(groupId)).data.status == 'active'
        && after.keys().hasOnly(announcementKeys())
        && after.diff(before).affectedKeys().hasOnly([
          'title', 'body', 'edited_at', 'publish_at'
        ])
        && after.group_id == before.group_id
        && after.teacher_id == before.teacher_id
        && before.teacher_id == request.auth.uid
        && after.created_at == before.created_at
        && after.schema_version == before.schema_version
        && validAnnouncementText(after.title, 120)
        && validAnnouncementText(after.body, 2000)
        && after.edited_at == request.time
        && (
          !after.diff(before).affectedKeys().hasAny(['publish_at'])
          || !after.keys().hasAny(['publish_at'])
          || (after.publish_at is timestamp && after.publish_at > request.time)
        );
    }

    match /groups/{groupId}/lifecycle/{documentId} {
      allow get: if documentId == 'status'
        && (isApprovedTraineeForGroup(groupId) || isGroupTeacher(groupId));
      allow list: if false;
      allow create, update: if documentId == 'status'
        && validClassroomStatusWrite(groupId);
      allow delete: if documentId == 'status'
        && isGroupTeacher(groupId)
        && (
          getAfter(groupPath(groupId)) == null
          || isAccountDeletionInProgress()
        );
    }

    match /groups/{groupId}/announcements/{announcementId} {
      allow get, list: if isSignedIn()
        && (
          isAnnouncementOwner(groupId)
          || (isApprovedAnnouncementMember(groupId)
            && (!resource.data.keys().hasAny(['publish_at'])
              || request.time >= resource.data.publish_at))
        );
      allow create: if validAnnouncementCreate(request.resource.data, groupId);
      allow update: if validAnnouncementUpdate(groupId);
      // A Teacher can moderate history after archiving a class. This is also
      // needed by account erasure before the Teacher profile is removed.
      allow delete: if isAnnouncementOwner(groupId);
    }

    match /group_invites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if validGroupInviteCreate(request.resource.data, inviteId);
      allow update: if false;
      allow delete: if isSignedIn()
        && resource != null
        && resource.data.teacher_id == request.auth.uid;
    }

    match /group_memberships/{membershipId} {
      allow get: if isMembershipParticipant();
      allow list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.trainee_id == request.auth.uid;
      allow list: if hasApprovedMembershipInSameGroup();

      allow create: if validPendingMembershipCreate(request.resource.data, membershipId);

      allow update: if isSignedIn()
        && validMembershipUpdateShape(request.resource.data)
        && (
          validTraineeMembershipTransition(membershipId)
          || validTeacherMembershipDecision()
          || validTeacherMembershipRemoval()
        );

      allow delete: if isSignedIn()
        && (resource == null || isMembershipParticipant());
    }

    // ---- Phase 5 classroom movements, assignments, attempts ----------------
    function assignmentPath(assignmentId) {
      return /databases/$(database)/documents/group_assignments/$(assignmentId);
    }
    function assignmentRecipientPath(assignmentId, traineeId) {
      return /databases/$(database)/documents/group_assignments/$(assignmentId)/assignment_recipients/$(traineeId);
    }
    function assignmentAttemptPath(attemptId) {
      return /databases/$(database)/documents/assignment_attempts/$(attemptId);
    }
    function teacherMovementPath(movementId) {
      return /databases/$(database)/documents/teacher_movements/$(movementId);
    }
    function teacherMovementRevisionPath(movementId, revisionId) {
      return /databases/$(database)/documents/teacher_movements/$(movementId)/revisions/$(revisionId);
    }
    function officialAssignmentAttemptId(sessionId) {
      return 'official_ptr_' + sessionId;
    }
    function teacherCreatedDraftAttemptId(assignmentId, traineeId) {
      return 'tc_draft_' + assignmentId + '_' + traineeId;
    }
    function isClassroomDocId(value) {
      return value is string && value.size() > 0 && value.size() <= 128
        && value.matches('^[A-Za-z0-9_-]+$');
    }
    function isBoundedText(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen
        && value.matches('.*[^[:space:]].*');
    }
    function isTrainingProp(value) {
      return value in ['bottle', 'shaker', 'bottle_and_shaker'];
    }
    function hasApprovedTraineeMembership(groupId, traineeId) {
      let membership = get(groupMembershipPath(groupId, traineeId)).data;
      return isSignedIn()
        && isClassroomDocId(groupId)
        && isClassroomDocId(traineeId)
        && membership.group_id == groupId
        && membership.trainee_id == traineeId
        && membership.teacher_id is string
        && membership.status == 'approved';
    }
    function assignmentContextKeys() {
      return ['assignment_id', 'group_id', 'teacher_id', 'movement_id', 'revision_id'];
    }
    function validAssignmentContextMap(ctx) {
      return ctx is map
        && ctx.keys().hasOnly(assignmentContextKeys())
        && isClassroomDocId(ctx.assignment_id)
        && isClassroomDocId(ctx.group_id)
        && isClassroomDocId(ctx.teacher_id)
        && isClassroomDocId(ctx.movement_id)
        && isClassroomDocId(ctx.revision_id);
    }
    function validOfficialAssignedSessionCreate(data, sessionId) {
      let ctx = data.assignment_context;
      let assignment = get(assignmentPath(ctx.assignment_id)).data;
      let membership = get(groupMembershipPath(ctx.group_id, request.auth.uid)).data;
      let pointer = getAfter(
        assignmentAttemptPath(officialAssignmentAttemptId(sessionId))
      ).data;
      return isClassroomDocId(sessionId)
        && validAssignmentContextMap(ctx)
        && assignmentIsPublished(assignment)
        && assignment.origin == 'official_elixr'
        && assignment.assessment_mode == 'official_guided'
        && assignment.teacher_id == ctx.teacher_id
        && assignment.group_id == ctx.group_id
        && assignment.movement_id == ctx.movement_id
        && assignment.revision_id == ctx.revision_id
        && assignmentAllowsTrainee(assignment, ctx.assignment_id, request.auth.uid)
        && assignment.official_movement_name == data.movement_name
        && membership.group_id == ctx.group_id
        && membership.trainee_id == request.auth.uid
        && membership.teacher_id == ctx.teacher_id
        && membership.status == 'approved'
        && pointer.source_session_id == sessionId
        && pointer.trainee_id == request.auth.uid
        && pointer.teacher_id == ctx.teacher_id
        && pointer.group_id == ctx.group_id
        && pointer.assignment_id == ctx.assignment_id
        && pointer.movement_id == ctx.movement_id
        && pointer.revision_id == ctx.revision_id
        && pointer.origin == 'official_elixr'
        && pointer.attempt_kind == 'practice_pointer'
        && pointer.status == 'submitted'
        && pointer.awards_global_xp == false;
    }
    function validSessionAssignmentContext(data, sessionId) {
      return !data.keys().hasAny(['assignment_context'])
        || validOfficialAssignedSessionCreate(data, sessionId);
    }

    function teacherMovementRootKeys() {
      return ['teacher_id', 'title', 'status', 'current_revision_id',
        'schema_version', 'created_at', 'updated_at'];
    }
    function teacherMovementRevisionKeys() {
      return ['movement_id', 'teacher_id', 'schema_version', 'assessment_mode',
        'spec', 'created_at'];
    }
    function teacherReviewedSpecKeys() {
      return ['instructions', 'required_prop', 'capability'];
    }
    function validActivityReadiness(value) {
      return value.keys().hasOnly(['hands', 'body'])
        && value.hands in ['none', 'one_hand', 'two_hands']
        && value.body in ['none', 'upper_body'];
    }
    function validLegacyActivityReadiness(value) {
      return value.keys().hasOnly(['prop', 'hands', 'body'])
        && value.prop in ['none', 'one_bottle', 'one_shaker',
          'bottle_and_shaker', 'two_bottles']
        && value.hands in ['none', 'one_hand', 'two_hands']
        && value.body in ['none', 'upper_body'];
    }
    function validActivityAttemptPolicy(value) {
      return value.type == 'unlimited'
        ? value.keys().hasOnly(['type'])
        : value.type == 'finite'
          && value.keys().hasOnly(['type', 'maximum_attempts'])
          && value.maximum_attempts in [1, 2, 3];
    }
    function validActivityRubric(value, maximumScore) {
      let keys = value.keys();
      let criteria = value.criteria;
      let count = criteria.size();
      let first = criteria[0];
      let second = criteria[1];
      let third = criteria[2];
      let fourth = count >= 4 ? criteria[3] : null;
      let fifth = count >= 5 ? criteria[4] : null;
      return keys.hasOnly(['template_id', 'maximum_score', 'criteria'])
        && value.template_id in ['standard_technique', 'beginner_fundamentals',
          'control_consistency', 'performance_flow', 'custom']
        && value.maximum_score == maximumScore
        && count >= 3 && count <= 5
        && validActivityCriterion(first)
        && validActivityCriterion(second)
        && validActivityCriterion(third)
        && (count < 4
          || validActivityCriterion(fourth))
        && (count < 5
          || validActivityCriterion(fifth))
        && activityCriterionIdsUnique(
          first, second, third, fourth, fifth, count
        )
        && activityCriterionTotal(
          first, second, third, fourth, fifth, count
        ) == maximumScore;
    }
    function validActivityCriterion(value) {
      let keys = value.keys();
      return keys.hasOnly(['id', 'label', 'description', 'maximum_points', 'weight'])
        && value.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && value.label.matches('(?s).{1,80}')
        && value.label.matches('.*[^[:space:]].*')
        && value.description.matches('(?s).{1,500}')
        && value.description.matches('.*[^[:space:]].*')
        && value.maximum_points is int
        && value.maximum_points >= 1
        && (!keys.hasAny(['weight'])
          || value.weight is int && value.weight >= 1 && value.weight <= 100);
    }
    function activityCriterionIdsUnique(
      first, second, third, fourth, fifth, count
    ) {
      return count == 3
        ? [first.id, second.id, third.id].toSet().size() == 3
        : count == 4
          ? [first.id, second.id, third.id, fourth.id]
              .toSet().size() == 4
          : [first.id, second.id, third.id, fourth.id, fifth.id]
              .toSet().size() == 5;
    }
    function activityCriterionTotal(
      first, second, third, fourth, fifth, count
    ) {
      return first.maximum_points + second.maximum_points
        + third.maximum_points
        + (count >= 4 ? fourth.maximum_points : 0)
        + (count >= 5 ? fifth.maximum_points : 0);
    }
    function validActivityDemo(value) {
      return value.keys().hasOnly(['storage_path', 'content_type', 'size_bytes',
          'duration_ms', 'source'])
        && isBoundedText(value.storage_path, 1024)
        && value.content_type == 'video/mp4'
        && value.size_bytes is int && value.size_bytes >= 1
        && value.size_bytes <= 50 * 1024 * 1024
        && value.duration_ms is int && value.duration_ms >= 1
        && value.duration_ms <= 60000
        && value.source in ['uploaded', 'recorded'];
    }
    function validActivityAssessment(value, maximumScore) {
      let keys = value.keys();
      return ((value.schema_version == 3
          && keys.hasOnly(['schema_version', 'readiness', 'rubric',
            'recording_duration_seconds', 'demonstration_video'])
          && validActivityReadiness(value.readiness))
          || (value.schema_version == 2
          && keys.hasOnly(['schema_version', 'readiness', 'rubric',
            'attempt_policy', 'recording_duration_seconds', 'demonstration_video'])
          && validLegacyActivityReadiness(value.readiness)
          && validActivityAttemptPolicy(value.attempt_policy)))
        && value.recording_duration_seconds in [15, 30, 45, 60]
        && validActivityRubric(value.rubric, maximumScore)
        && (!keys.hasAny(['demonstration_video'])
          || validActivityDemo(value.demonstration_video));
    }
    function validTeacherReviewedSpec(spec) {
      return spec is map
        && spec.keys().hasOnly(teacherReviewedSpecKeys().concat([
          'safety_guidance', 'activity_assessment'
        ]))
        && isBoundedText(spec.instructions, 2000)
        && isTrainingProp(spec.required_prop)
        && spec.capability == 'teacher_review_only'
        && (
          !spec.keys().hasAny(['safety_guidance'])
          || isBoundedText(spec.safety_guidance, 1000)
        )
        && (
          !spec.keys().hasAny(['activity_assessment'])
          || validActivityAssessment(
            spec.activity_assessment,
            spec.activity_assessment.rubric.maximum_score
          )
        );
    }
    function validTeacherMovementCreate(data, movementId) {
      return isVerifiedTeacher()
        && isClassroomDocId(movementId)
        && data.keys().hasOnly(teacherMovementRootKeys())
        && data.teacher_id == request.auth.uid
        && isParticipantId(data.teacher_id)
        && isBoundedText(data.title, 80)
        && data.status == 'active'
        && isClassroomDocId(data.current_revision_id)
        && data.schema_version == 1
        && data.created_at == request.time
        && data.updated_at == request.time
        && existsAfter(teacherMovementRevisionPath(movementId, data.current_revision_id))
        && getAfter(teacherMovementRevisionPath(movementId, data.current_revision_id)).data.teacher_id
          == request.auth.uid
        && getAfter(teacherMovementRevisionPath(movementId, data.current_revision_id)).data.movement_id
          == movementId;
    }
    function validTeacherMovementRootIdentity() {
      return request.resource.data.keys().hasOnly(teacherMovementRootKeys())
        && request.resource.data.teacher_id == resource.data.teacher_id
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.schema_version == resource.data.schema_version
        && request.resource.data.updated_at == request.time
        && isBoundedText(request.resource.data.title, 80)
        && isClassroomDocId(request.resource.data.current_revision_id);
    }
    function validTeacherMovementArchiveUpdate(movementId) {
      return resource.data.status == 'active'
        && request.resource.data.status == 'archived'
        && get(teacherMovementRevisionPath(
          movementId, resource.data.current_revision_id
        )).data.assessment_mode == 'teacher_reviewed'
        && request.resource.data.title == resource.data.title
        && request.resource.data.current_revision_id == resource.data.current_revision_id
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updated_at']);
    }
    function validTeacherMovementPublishRevisionUpdate(movementId) {
      // Target revision must be newly created in this same atomic request.
      // getAfter() alone is insufficient: it also succeeds for a historical
      // revision that already existed. Do not bind getAfter(...).data in a
      // `let` — that evaluates eagerly before existsAfter() can short-circuit.
      // The revision's own create rule independently requires
      // validTeacherMovementRevisionCreate (teacher_reviewed, created_at ==
      // request.time, current root pointer == this revision id).
      let revisionPath = teacherMovementRevisionPath(
        movementId,
        request.resource.data.current_revision_id
      );
      return resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && get(teacherMovementRevisionPath(
          movementId, resource.data.current_revision_id
        )).data.assessment_mode == 'teacher_reviewed'
        && request.resource.data.current_revision_id != resource.data.current_revision_id
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'current_revision_id', 'updated_at'])
        && !exists(revisionPath)
        && existsAfter(revisionPath)
        && getAfter(revisionPath).data.movement_id == movementId
        && getAfter(revisionPath).data.teacher_id == request.auth.uid;
    }
    function validTeacherMovementUpdate(movementId) {
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && validTeacherMovementRootIdentity()
        && (
          validTeacherMovementArchiveUpdate(movementId)
          || validTeacherMovementPublishRevisionUpdate(movementId)
        );
    }
    function validTeacherMovementRevisionCreate(data, movementId, revisionId) {
      let afterRoot = getAfter(teacherMovementPath(movementId)).data;
      return isVerifiedTeacher()
        && isClassroomDocId(movementId)
        && isClassroomDocId(revisionId)
        && data.keys().hasOnly(teacherMovementRevisionKeys())
        && data.movement_id == movementId
        && data.teacher_id == request.auth.uid
        && data.schema_version in [1, 2]
        && data.assessment_mode == 'teacher_reviewed'
        && validTeacherReviewedSpec(data.spec)
        && data.created_at == request.time
        && afterRoot.teacher_id == request.auth.uid
        && afterRoot.current_revision_id == revisionId;
    }
    match /teacher_movements/{movementId} {
      allow get, list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
      allow create: if validTeacherMovementCreate(request.resource.data, movementId);
      allow update: if validTeacherMovementUpdate(movementId);
      allow delete: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid
        && (
          (get(teacherMovementRevisionPath(
            movementId, resource.data.current_revision_id
          )).data.assessment_mode != 'template_scored'
            && isVerifiedTeacher())
          || !exists(userPath(request.auth.uid))
        );

      match /revisions/{revisionId} {
        allow get, list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
        allow create: if validTeacherMovementRevisionCreate(
          request.resource.data, movementId, revisionId
        );
        allow update: if false;
        allow delete: if isSignedIn()
          && resource.data.teacher_id == request.auth.uid
          && (
            (resource.data.assessment_mode != 'template_scored'
              && isVerifiedTeacher())
            || !exists(userPath(request.auth.uid))
          );
      }
    }

    function groupAssignmentRequiredKeys() {
      return ['teacher_id', 'group_id', 'movement_id', 'revision_id', 'origin',
        'assessment_mode', 'status', 'display_title', 'teacher_display_name',
        'group_name', 'created_at', 'updated_at'];
    }
    function groupAssignmentAllowedKeys() {
      return groupAssignmentRequiredKeys().concat([
        'official_movement_name', 'display_instructions',
        'display_safety_guidance', 'allowed_prop', 'due_at', 'max_score',
        'grading_locked', 'grading_locked_at', 'audience_type', 'topic',
        'configuration_revision', 'activity_assessment', 'attempt_policy', 'deletion_state', 'publish_at',
      ]);
    }
    function teacherCreatedAssignmentAllowedKeys() {
      return groupAssignmentRequiredKeys().concat([
        'display_instructions', 'display_safety_guidance', 'allowed_prop',
        'due_at', 'max_score', 'grading_locked', 'audience_type', 'topic',
        'configuration_revision', 'activity_assessment', 'attempt_policy',
        'deletion_state', 'publish_at'
      ]);
    }
    function isLegacyEntireClassAssignment(data) {
      return !data.keys().hasAny(['audience_type', 'target_trainee_ids']);
    }
    function validAssignmentAudienceShape(data) {
      let keys = data.keys();
      return !keys.hasAny(['target_trainee_ids'])
        && data.audience_type in ['entire_class', 'selected_students', 'individual_student'];
    }
    function validAssignmentRecipient(data, assignmentId, traineeId) {
      return data.keys().hasOnly([
          'assignment_id', 'group_id', 'teacher_id', 'trainee_id',
          'audience_type', 'schema_version', 'created_at'
        ])
        && data.assignment_id == assignmentId
        && data.trainee_id == traineeId
        && isClassroomDocId(assignmentId)
        && isClassroomDocId(data.group_id)
        && isClassroomDocId(data.teacher_id)
        && isClassroomDocId(traineeId)
        && data.audience_type in ['selected_students', 'individual_student']
        && data.schema_version == 1
        && data.created_at is timestamp;
    }
    function assignmentRecipientMatches(data, assignmentId, traineeId) {
      // Recipient rows are server-owned (the client create/update rules below
      // are closed). Keep this authorization hot path to immutable identity
      // fields so an atomic session + pointer write stays under the Rules
      // expression budget; direct recipient reads still use the full shape
      // validator above.
      let recipient = get(assignmentRecipientPath(assignmentId, traineeId)).data;
      return recipient.keys().hasOnly([
          'assignment_id', 'group_id', 'teacher_id', 'trainee_id',
          'audience_type', 'schema_version', 'created_at'
        ])
        && isClassroomDocId(assignmentId)
        && isClassroomDocId(traineeId)
        && isClassroomDocId(recipient.group_id)
        && isClassroomDocId(recipient.teacher_id)
        && recipient.assignment_id == assignmentId
        && recipient.trainee_id == traineeId
        && recipient.group_id == data.group_id
        && recipient.teacher_id == data.teacher_id
        && recipient.audience_type == data.audience_type
        && recipient.audience_type in ['selected_students', 'individual_student']
        && recipient.schema_version == 1
        && recipient.created_at is timestamp;
    }
    function assignmentAllowsTrainee(data, assignmentId, traineeId) {
      return isLegacyEntireClassAssignment(data)
        || (
          validAssignmentAudienceShape(data)
          && (
            data.audience_type == 'entire_class'
            || (
              exists(assignmentRecipientPath(assignmentId, traineeId))
              && assignmentRecipientMatches(data, assignmentId, traineeId)
            )
          )
        );
    }
    function traineeCanAccessAssignment(data, assignmentId, traineeId) {
      let membership = get(groupMembershipPath(data.group_id, traineeId)).data;
      return assignmentIsPublished(data)
        && assignmentAllowsTrainee(data, assignmentId, traineeId)
        && hasApprovedTraineeMembership(data.group_id, traineeId)
        && membership.teacher_id == data.teacher_id;
    }
    // request.time is evaluated by Firestore, not the client. Legacy active
    // records intentionally remain published without publication metadata.
    function assignmentIsPublished(data) {
      return data.status == 'active'
        || (data.status == 'scheduled'
          && data.keys().hasAny(['publish_at'])
          && data.publish_at is timestamp
          && request.time >= data.publish_at);
    }
    function validOfficialAssignmentCreate(data) {
      return data.origin == 'official_elixr'
        && data.assessment_mode == 'official_guided'
        && data.keys().hasAny(['official_movement_name'])
        && data.official_movement_name is string
        && isOfficialElixrMovementName(data.official_movement_name)
        && data.movement_id == officialMovementIdForName(data.official_movement_name)
        && data.revision_id == officialRevisionIdForName(data.official_movement_name)
        && data.display_title == data.official_movement_name
        && !data.keys().hasAny(['allowed_prop'])
        && !data.keys().hasAny(['assessment_spec'])
        && (
          !data.keys().hasAny(['display_instructions'])
          || isBoundedText(data.display_instructions, 2000)
        )
        && !data.keys().hasAny(['display_safety_guidance']);
    }
    function validTeacherCreatedAssignmentCreate(data, teacherId) {
      let movementId = data.movement_id;
      let revisionId = data.revision_id;
      let movement = get(teacherMovementPath(movementId)).data;
      let revision = get(
        teacherMovementRevisionPath(movementId, revisionId)
      ).data;
      let keys = data.keys();
      let instructions = data.display_instructions;
      let allowedProp = data.allowed_prop;
      let spec = revision.spec;
      return data.assessment_mode == 'teacher_reviewed'
        && movement.teacher_id == teacherId
        && movement.status == 'active'
        && movement.current_revision_id == revisionId
        && revision.movement_id == movementId
        && revision.teacher_id == teacherId
        && data.display_title == movement.title
        && isBoundedText(instructions, 2000)
        && instructions == spec.instructions
        && isTrainingProp(allowedProp)
        && allowedProp == spec.required_prop
        && data.get('display_safety_guidance', '__elixr_absent__')
          == spec.get('safety_guidance', '__elixr_absent__')
        && (
          !keys.hasAny(['display_safety_guidance'])
          || isBoundedText(data.display_safety_guidance, 1000)
        )
        // Missing fields remain readable as legacy assignments created before
        // the grading contract was introduced.
        && (
          !keys.hasAny(['max_score'])
          || data.max_score is int && data.max_score >= 1 && data.max_score <= 100
        )
        && data.get('grading_locked', false) == false
        ;
    }
    function validTeacherCreatedActivityAssignmentCreate(data) {
      let groupId = data.group_id;
      let movementId = data.movement_id;
      let revisionId = data.revision_id;
      let teacherId = request.auth.uid;
      let maxScore = data.max_score;
      let group = get(groupPath(groupId)).data;
      let movement = get(teacherMovementPath(movementId)).data;
      let revision = get(
        teacherMovementRevisionPath(movementId, revisionId)
      ).data;
      let keys = data.keys();
      // Movement/revision/profile writes validate the source snapshots; these
      // equalities bind the assignment to those trusted values. Keep the
      // inline shape checks shallow so five-criterion Activity writes fit.
      return isVerifiedTeacher()
        && keys.hasOnly(teacherCreatedAssignmentAllowedKeys())
        && data.assessment_mode == 'teacher_reviewed'
        && revision.assessment_mode == data.assessment_mode
        && data.audience_type == 'entire_class'
        && data.teacher_id == teacherId
        && groupId.matches('^[A-Za-z0-9_-]{1,128}$')
        && movementId.matches('^[A-Za-z0-9_-]{1,128}$')
        && revisionId.matches('^[A-Za-z0-9_-]{1,128}$')
        && group.teacher_id == teacherId
        && group.status == 'active'
        && data.group_name == group.name
        && data.teacher_display_name.matches('(?s).{1,80}')
        && data.teacher_display_name == userFullName(teacherId)
        && movement.teacher_id == teacherId
        && movement.status == 'active'
        && movement.current_revision_id == revisionId
        && revision.movement_id == movementId
        && revision.teacher_id == teacherId
        && data.display_title.size() <= 80
        && data.display_title.matches('.*[^[:space:]].*')
        && data.display_title == movement.title
        && data.display_instructions.size() <= 2000
        && data.display_instructions.matches('.*[^[:space:]].*')
        && data.display_instructions == revision.spec.instructions
        && isTrainingProp(data.allowed_prop)
        && data.allowed_prop == revision.spec.required_prop
        && data.get('display_safety_guidance', '__elixr_absent__')
          == revision.spec.get('safety_guidance', '__elixr_absent__')
        && (!keys.hasAny(['display_safety_guidance'])
          || (
            data.display_safety_guidance.size() <= 1000
            && data.display_safety_guidance.matches('.*[^[:space:]].*')
          ))
        && validActivityAttemptPolicy(data.attempt_policy)
        && validAssignmentPublicationShape(data)
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.configuration_revision == 1
        && maxScore is int && maxScore <= 100
        && (
          !keys.hasAny(['due_at'])
          || data.due_at is timestamp
        )
        && (!keys.hasAny(['topic']) || isBoundedText(data.topic, 80))
        && data.get('grading_locked', false) == false
        && validActivityAssessment(data.activity_assessment, maxScore);
    }
    function validGroupAssignmentCreate(data) {
      let group = get(groupPath(data.group_id)).data;
      let keys = data.keys();
      let teacherId = request.auth.uid;
      return !(
          data.origin == 'teacher_created'
          && keys.hasAny(['activity_assessment', 'configuration_revision'])
        )
        && isVerifiedTeacher()
        && data.audience_type == 'entire_class'
        && data.teacher_id == teacherId
        && isParticipantId(data.teacher_id)
        && isClassroomDocId(data.group_id)
        && isClassroomDocId(data.movement_id)
        && isClassroomDocId(data.revision_id)
        && group.teacher_id == teacherId
        && group.status == 'active'
        && data.group_name == group.name
        && isDisplayName(data.teacher_display_name)
        && data.teacher_display_name == userFullName(teacherId)
        && validActivityAttemptPolicy(data.attempt_policy)
        && isBoundedText(data.display_title, 80)
        && validAssignmentPublicationShape(data)
        && data.created_at == request.time
        && data.updated_at == request.time
        && (
          !keys.hasAny(['due_at'])
          || data.due_at is timestamp
        )
        && (!keys.hasAny(['topic']) || isBoundedText(data.topic, 80))
        && (
          data.origin == 'official_elixr'
            ? keys.hasOnly(groupAssignmentAllowedKeys())
              && validOfficialAssignmentCreate(data)
            : data.origin == 'teacher_created'
              && keys.hasOnly(teacherCreatedAssignmentAllowedKeys())
              && validTeacherCreatedAssignmentCreate(data, teacherId)
        );
    }
    function validGroupAssignmentUpdate() {
      return isVerifiedTeacher()
        && resource.data.teacher_id == request.auth.uid
        && resource.data.assessment_mode != 'template_scored'
        && request.resource.data.keys().hasAll(groupAssignmentRequiredKeys())
        && request.resource.data.keys().hasOnly(groupAssignmentAllowedKeys())
        && validAssignmentPublicationShape(request.resource.data)
        && validAssignmentLifecycleTransition(resource.data, request.resource.data)
        && request.resource.data.updated_at == request.time
        && (
          !request.resource.data.keys().hasAny(['due_at'])
          || request.resource.data.due_at is timestamp
        )
        && (!request.resource.data.keys().hasAny(['topic'])
          || isBoundedText(request.resource.data.topic, 80))
        && (
          resource.data.origin != 'official_elixr'
          || (
            !request.resource.data.keys().hasAny(['max_score',
              'grading_locked', 'grading_locked_at'])
          )
        )
        && (
          !request.resource.data.keys().hasAny(['max_score'])
          || request.resource.data.max_score is int
            && request.resource.data.max_score >= 1
            && request.resource.data.max_score <= 100
        )
        && (
          !request.resource.data.keys().hasAny(['grading_locked'])
          || request.resource.data.grading_locked is bool
        )
        && (
          request.resource.data.get('grading_locked', false) == true
          ? request.resource.data.grading_locked_at is timestamp
          : !request.resource.data.keys().hasAny(['grading_locked_at'])
        )
        && (
          request.resource.data.get('grading_locked', false) == true
          || !resource.data.get('grading_locked', false)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['max_score'])
          || !resource.data.get('grading_locked', false)
        )
        && (
          !resource.data.keys().hasAny(['activity_assessment'])
          || (
            request.resource.data.max_score == resource.data.max_score
            && request.resource.data.activity_assessment
              == resource.data.activity_assessment
            && request.resource.data.configuration_revision
              == resource.data.configuration_revision
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'due_at', 'updated_at', 'max_score',
          'grading_locked', 'grading_locked_at', 'topic', 'publish_at']);
    }

    function validAssignmentPublicationShape(data) {
      return (
          data.status in ['draft', 'active', 'archived']
          && !data.keys().hasAny(['publish_at'])
        ) || (
          data.status == 'scheduled'
          && data.keys().hasAny(['publish_at'])
          && data.publish_at is timestamp
          && request.time < data.publish_at
          && (!data.keys().hasAny(['due_at']) || data.due_at > data.publish_at)
        );
    }

    function validAssignmentLifecycleTransition(before, after) {
      return (before.status == after.status)
        || (before.status == 'draft' && after.status in ['scheduled', 'active'])
        || (before.status == 'scheduled' && after.status in ['scheduled', 'active'])
        || (before.status == 'active' && after.status == 'archived')
        || (before.status == 'archived' && after.status == 'active');
    }

    match /group_assignments/{assignmentId} {
      allow get: if isSignedIn()
        && (
          resource.data.teacher_id == request.auth.uid
          || traineeCanAccessAssignment(resource.data, assignmentId, request.auth.uid)
        );
      allow list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
      allow create: if request.resource.data.origin == 'teacher_created'
        && request.resource.data.keys().hasAny([
          'activity_assessment', 'configuration_revision'
        ])
        && validTeacherCreatedActivityAssignmentCreate(request.resource.data);
      allow create: if validGroupAssignmentCreate(request.resource.data);
      allow update: if validGroupAssignmentUpdate();
      allow delete: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid
        && (
          !exists(userPath(request.auth.uid))
          || get(userPath(request.auth.uid)).data.get('lifecycle_state', 'active')
            == 'deleting'
        );

      match /assignment_recipients/{traineeId} {
        // A Teacher query is constrained by teacher_id and does not perform a
        // parent get per row. The client revalidates every row before use.
        allow get: if isSignedIn()
          && resource.data.teacher_id == request.auth.uid
          && validAssignmentRecipient(resource.data, assignmentId, traineeId);
        // Collection-group queries must be provable from their query
        // constraint alone. The teacher query is constrained by teacher_id;
        // the client validates the immutable row shape and parent identity.
        allow list: if isSignedIn()
          && resource.data.teacher_id == request.auth.uid;
        // A Trainee can direct-read only their own relationship; querying or
        // enumerating projections is denied so classmates' UIDs stay private.
        allow get: if isSignedIn()
          && traineeId == request.auth.uid
          && validAssignmentRecipient(resource.data, assignmentId, traineeId)
          && exists(assignmentPath(assignmentId))
          && traineeCanAccessAssignment(
            get(assignmentPath(assignmentId)).data, assignmentId, traineeId
          );
        // After users/{uid} is removed, account erasure may query/delete just
        // this caller's recipient rows without parent-document access calls.
        allow list: if isSignedIn()
          && !exists(userPath(request.auth.uid))
          && resource.data.trainee_id == request.auth.uid;
        allow delete: if isSignedIn()
          && !exists(userPath(request.auth.uid))
          && (
            (traineeId == request.auth.uid && resource.data.trainee_id == request.auth.uid)
            || resource.data.teacher_id == request.auth.uid
          );
        allow create, update: if false;
      }
    }

    // Collection-group queries need a recursive match because their parent
    // path is not fixed at query planning time. Keep the query predicates
    // narrow; direct reads remain governed by the deterministic nested match
    // above.
    match /{anyPath=**}/assignment_recipients/{traineeId} {
      allow list: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid;
      allow list: if isSignedIn()
        && !exists(userPath(request.auth.uid))
        && resource.data.trainee_id == request.auth.uid;
    }

    function assignmentAttemptIdentityKeys() {
      return ['trainee_id', 'teacher_id', 'group_id', 'assignment_id',
        'movement_id', 'revision_id', 'origin', 'assessment_mode',
        'attempt_kind', 'status', 'awards_global_xp', 'created_at'];
    }
    function officialPointerAllowedKeys() {
      return assignmentAttemptIdentityKeys().concat([
        'source_session_id', 'assessment_version', 'rubric', 'rubric_total',
        'performance_level', 'duration_seconds', 'prop_type', 'completed_at'
      ]);
    }
    function teacherDraftAllowedKeys() {
      return assignmentAttemptIdentityKeys();
    }
    function teacherReviewSubmissionCreateKeys() {
      return assignmentAttemptIdentityKeys().concat([
        'supersedes_attempt_id', 'attempt_number', 'reservation_request_id',
        'assignment_configuration_revision', 'activity_assessment_snapshot',
        'recording_started_at'
      ]);
    }
    function teacherReviewSubmissionAnchorKeys() {
      return assignmentAttemptIdentityKeys().concat(['deletion_failed']);
    }
    // A successful unsubmit returns the canonical attempt to this anchor with
    // `deletion_failed: false`. Treat it as empty work so the trainee can
    // attach a new private recording, then remove the recovery marker.
    function isCanonicalTeacherReviewSubmissionEmptyAnchor(data) {
      return data.keys().hasOnly(assignmentAttemptIdentityKeys())
        || (
          data.keys().hasOnly(teacherReviewSubmissionAnchorKeys())
          && data.deletion_failed == false
        );
    }
    function teacherReviewSubmissionSubmittedKeys() {
      return teacherReviewSubmissionCreateKeys().concat([
        'video_storage_path', 'video_content_type', 'video_size_bytes',
        'video_duration_ms', 'submitted_at', 'video_expires_at'
      ]);
    }
    function teacherReviewSubmissionAttachedDraftKeys() {
      return assignmentAttemptIdentityKeys().concat([
        'video_storage_path', 'video_content_type', 'video_size_bytes',
        'video_duration_ms', 'draft_saved_at'
      ]);
    }
    function teacherReviewSubmissionDraftRemovalKeys() {
      return teacherReviewSubmissionAttachedDraftKeys().concat([
        'draft_cleanup_started_at'
      ]);
    }
    function teacherReviewSubmissionReviewedKeys() {
      return teacherReviewSubmissionSubmittedKeys().concat([
        'review_verdict', 'review_feedback', 'reviewed_at'
      ]);
    }
    function teacherReviewSubmissionCheckedKeys() {
      return teacherReviewSubmissionSubmittedKeys().concat([
        'review_feedback', 'grade_score', 'grade_max_score', 'checked_at',
        'criterion_scores',
        'review_updated_at', 'review_revision', 'result_sent_revision',
        'result_sent_at', 'result_message_id', 'video_deleted_at',
        'deletion_failed', 'deletion_failed_at',
      ]);
    }
    function canonicalAssignmentSubmissionPath(data, attemptId) {
      return 'assignment_submissions/' + data.teacher_id + '/' + data.group_id
        + '/' + data.assignment_id + '/' + data.trainee_id + '/' + attemptId
        + '.mp4';
    }
    function isReviewSubmissionAttemptId(attemptId) {
      return attemptId.matches('^review_sub_[A-Za-z0-9_-]+$')
        && attemptId.size() <= 128;
    }
    function isUnreviewedVideoExpiry(value) {
      return value is timestamp
        && value >= request.time + duration.value(29, 'd')
        && value <= request.time + duration.value(31, 'd');
    }
    function isReviewedVideoExpiry(value) {
      return value is timestamp
        && value >= request.time + duration.value(13, 'd')
        && value <= request.time + duration.value(15, 'd');
    }
    function validSubmittedVideoMetadata(data, attemptId) {
      return data.video_storage_path == canonicalAssignmentSubmissionPath(data, attemptId)
        && data.video_content_type == 'video/mp4'
        && data.video_size_bytes is int
        && data.video_size_bytes > 0
        && data.video_size_bytes <= 52428800
        && data.video_duration_ms is int
        && data.video_duration_ms > 0
        && data.video_duration_ms <= 60000;
    }
    function attemptMatchesAssignment(data) {
      let assignment = get(assignmentPath(data.assignment_id)).data;
      return assignment.teacher_id == data.teacher_id
        && assignment.group_id == data.group_id
        && assignment.movement_id == data.movement_id
        && assignment.revision_id == data.revision_id
        && assignment.origin == data.origin
        && assignment.assessment_mode == data.assessment_mode
        && assignmentAllowsTrainee(assignment, data.assignment_id, data.trainee_id)
        && assignmentIsPublished(assignment);
    }
    function assignmentSubmissionIsOpen(data) {
      let assignment = get(assignmentPath(data.assignment_id)).data;
      return assignmentIsPublished(assignment)
        && assignment.get('deletion_state', 'active') != 'deleting'
        && (
          traineeCanAccessAssignment(assignment, data.assignment_id, data.trainee_id)
          || data.get('recording_started_at', null) is timestamp
        )
        && (
          !assignment.keys().hasAny(['due_at'])
          || request.time <= assignment.due_at
          || (
            data.get('recording_started_at', null) is timestamp
            && data.recording_started_at <= assignment.due_at
          )
        );
    }
    function validOfficialPointerCreate(data, attemptId) {
      let session = getAfter(sessionPath(data.source_session_id)).data;
      let ctx = session.assignment_context;
      return data.attempt_kind == 'practice_pointer'
        && data.status == 'submitted'
        && data.origin == 'official_elixr'
        && data.assessment_mode == 'official_guided'
        && data.keys().hasOnly(officialPointerAllowedKeys())
        && isClassroomDocId(data.source_session_id)
        && attemptId == officialAssignmentAttemptId(data.source_session_id)
        && session.user_id == request.auth.uid
        && validAssignmentContextMap(ctx)
        && ctx.assignment_id == data.assignment_id
        && ctx.group_id == data.group_id
        && ctx.teacher_id == data.teacher_id
        && ctx.movement_id == data.movement_id
        && ctx.revision_id == data.revision_id
        && data.rubric_total == session.rubric_total
        && data.performance_level == session.performance_level
        && data.duration_seconds == session.duration_seconds
        && data.prop_type == session.prop_type
        && data.assessment_version == session.assessment_version
        && data.rubric.technique == session.rubric.technique
        && data.rubric.stability == session.rubric.stability
        && data.rubric.completion == session.rubric.completion
        && data.rubric.prop_positioning == session.rubric.prop_positioning
        && data.completed_at == session.created_at
        && data.completed_at == request.time;
    }
    function validTeacherDraftAttemptCreate(data, attemptId) {
      return data.attempt_kind == 'teacher_review_draft'
        && attemptId == teacherCreatedDraftAttemptId(data.assignment_id, data.trainee_id)
        && data.status in ['draft', 'in_progress']
        && data.origin == 'teacher_created'
        && data.assessment_mode == 'teacher_reviewed'
        && data.keys().hasOnly(teacherDraftAllowedKeys())
        && data.status != 'approved'
        && data.status != 'needs_retry';
    }
    function validSubmissionSupersedes(data) {
      let previous = get(assignmentAttemptPath(data.supersedes_attempt_id)).data;
      return isClassroomDocId(data.supersedes_attempt_id)
        && previous.attempt_kind == 'teacher_review_submission'
        && previous.status == 'needs_retry'
        && previous.review_verdict == 'needs_retry'
        && previous.trainee_id == data.trainee_id
        && previous.teacher_id == data.teacher_id
        && previous.group_id == data.group_id
        && previous.assignment_id == data.assignment_id
        && previous.movement_id == data.movement_id
        && previous.revision_id == data.revision_id;
    }
    function validTeacherReviewSubmissionCreate(data, attemptId) {
      let assignment = get(assignmentPath(data.assignment_id)).data;
      return !assignment.keys().hasAny(['activity_assessment'])
        && data.attempt_kind == 'teacher_review_submission'
        && isReviewSubmissionAttemptId(attemptId)
        && data.origin == 'teacher_created'
        && data.assessment_mode == 'teacher_reviewed'
        && (
          (
            attemptId == 'review_sub_' + data.assignment_id + '_' + data.trainee_id
            && data.status == 'in_progress'
            && data.keys().hasOnly(assignmentAttemptIdentityKeys())
            && assignmentSubmissionIsOpen(data)
          )
          || (
            data.status == 'draft'
            && data.keys().hasOnly(teacherReviewSubmissionCreateKeys())
            && (
              !data.keys().hasAny(['supersedes_attempt_id'])
              || validSubmissionSupersedes(data)
            )
          )
        );
    }
    function validAssignmentAttemptCreate(data, attemptId) {
      let membership = get(groupMembershipPath(data.group_id, request.auth.uid)).data;
      return isSignedIn()
        && data.trainee_id == request.auth.uid
        && isClassroomDocId(attemptId)
        && isClassroomDocId(data.trainee_id)
        && isClassroomDocId(data.teacher_id)
        && isClassroomDocId(data.group_id)
        && isClassroomDocId(data.assignment_id)
        && isClassroomDocId(data.movement_id)
        && isClassroomDocId(data.revision_id)
        && data.awards_global_xp == false
        && data.created_at == request.time
        && membership.group_id == data.group_id
        && membership.trainee_id == request.auth.uid
        && membership.teacher_id == data.teacher_id
        && membership.status == 'approved'
        && attemptMatchesAssignment(data)
        && (
          data.attempt_kind == 'practice_pointer'
            ? validOfficialPointerCreate(data, attemptId)
            : data.attempt_kind == 'teacher_review_draft'
              ? validTeacherDraftAttemptCreate(data, attemptId)
              : validTeacherReviewSubmissionCreate(data, attemptId)
        );
    }
    function assignmentAttemptFrozenKeys() {
      return ['trainee_id', 'teacher_id', 'group_id', 'assignment_id',
        'movement_id', 'revision_id', 'origin', 'assessment_mode',
        'attempt_kind', 'awards_global_xp', 'created_at'];
    }
    function assignmentAttemptOptionalFrozenKeys() {
      return ['source_session_id', 'supersedes_attempt_id',
        'assignment_configuration_revision', 'activity_assessment_snapshot',
        'attempt_number', 'reservation_request_id', 'recording_started_at'];
    }
    function assignmentAttemptIdentityUnchanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.keys().hasAll(assignmentAttemptFrozenKeys())
        && request.resource.data.keys().hasAll(assignmentAttemptFrozenKeys())
        && !changed.hasAny(assignmentAttemptFrozenKeys().concat(
          assignmentAttemptOptionalFrozenKeys()
        ))
        && request.resource.data.awards_global_xp == false
        && resource.data.awards_global_xp == false;
    }
    function assignmentAttemptVideoIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'video_storage_path', 'video_content_type', 'video_size_bytes',
        'video_duration_ms', 'submitted_at'
      ]);
    }
    function assignmentAttemptClipMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'video_storage_path', 'video_content_type', 'video_size_bytes',
        'video_duration_ms'
      ]);
    }
    function assignmentAttemptReviewUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'status', 'review_verdict', 'review_feedback', 'reviewed_at'
      ]);
    }
    function assignmentAttemptReviewableMetadataUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'video_content_type', 'video_size_bytes', 'video_duration_ms',
        'submitted_at', 'video_expires_at'
      ]);
    }
    function validTeacherDraftAttemptUpdate() {
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_draft'
        && resource.data.origin == 'teacher_created'
        && assignmentSubmissionIsOpen(resource.data)
        && assignmentAttemptIdentityUnchanged()
        && request.resource.data.keys().hasOnly(teacherDraftAllowedKeys())
        && resource.data.status == 'draft'
        && request.resource.data.status == 'in_progress'
        && !request.resource.data.keys().hasAny(['review_verdict',
          'review_feedback', 'reviewed_at'])
        && request.resource.data.status != 'approved'
        && request.resource.data.status != 'needs_retry';
    }
    function validTeacherReviewSubmissionTraineeSubmit(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && resource.data.status in ['draft', 'in_progress']
        && !resource.data.keys().hasAny(['abandoned_at'])
        && assignmentSubmissionIsOpen(resource.data)
        && after.status == 'submitted'
        && !after.keys().hasAny(['abandoned_at'])
        && assignmentAttemptIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionSubmittedKeys())
        && validSubmittedVideoMetadata(after, attemptId)
        && (!resource.data.keys().hasAny(['draft_saved_at'])
          || assignmentAttemptClipMetadataUnchanged())
        && after.submitted_at == request.time
        && isUnreviewedVideoExpiry(after.video_expires_at)
        && !after.keys().hasAny(['review_verdict', 'review_feedback',
          'reviewed_at']);
    }
    function validCanonicalTeacherReviewSubmissionAttachDraft(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId == 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'in_progress'
        && isCanonicalTeacherReviewSubmissionEmptyAnchor(resource.data)
        && assignmentSubmissionIsOpen(resource.data)
        && assignmentAttemptIdentityUnchanged()
        && after.status == 'in_progress'
        && after.keys().hasOnly(teacherReviewSubmissionAttachedDraftKeys())
        && validSubmittedVideoMetadata(after, attemptId)
        && after.draft_saved_at == request.time;
    }
    function validCanonicalTeacherReviewSubmissionBeginDraftRemoval(attemptId) {
      let after = request.resource.data;
      return resource.data.trainee_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && attemptId == 'review_sub_' + resource.data.assignment_id + '_'
          + resource.data.trainee_id
        && resource.data.status == 'in_progress'
        && resource.data.keys().hasOnly(teacherReviewSubmissionAttachedDraftKeys())
        && assignmentAttemptIdentityUnchanged()
        && after.status == 'in_progress'
        && after.keys().hasOnly(teacherReviewSubmissionDraftRemovalKeys())
