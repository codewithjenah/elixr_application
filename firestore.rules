rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/sessions/$(resource.data.session_id)).data.user_id == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.session_id)).data.user_id == request.auth.uid;
    }
  }
}
