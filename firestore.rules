    // Server-owned concurrency ledger. Clients cannot forge limits, active
    // reservations, latest-submission identity, or grading locks.
    match /assignment_attempt_states/{stateId} {
      allow read, write: if false;
    }

    match /assignment_attempts/{attemptId} {
      allow get: if isSignedIn()
        && (
          resource.data.trainee_id == request.auth.uid
          || resource.data.teacher_id == request.auth.uid
        );
      allow list: if isSignedIn() && resource.data.teacher_id == request.auth.uid;
      allow list: if isSignedIn() && resource.data.trainee_id == request.auth.uid;
      allow create: if validAssignmentAttemptCreate(request.resource.data, attemptId);
      allow update: if isSignedIn()
        && (
          // Gate the cleanup paths before their full predicates. This keeps
          // ordinary submission transitions from evaluating recovery-only
          // rules, while letting abandoned drafts avoid the later, expensive
          // review-transition predicate chain.
          (request.resource.data.keys().hasAny(['abandoned_at'])
            && validTeacherReviewSubmissionAbandon(attemptId))
          || (resource.data.keys().hasAny(['abandoned_at'])
            && validAbandonedTeacherReviewCleanup(attemptId))
          || (resource.data.attempt_kind == 'teacher_review_submission'
            && resource.data.status == 'draft'
            && request.resource.data.status == 'in_progress'
            && validCanonicalTeacherReviewSubmissionPromote(attemptId))
          || (resource.data.attempt_kind == 'teacher_review_submission'
            && request.resource.data.status == 'submitted'
            && validTeacherReviewSubmissionTraineeSubmit(attemptId))
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['video_deleted_at'])
            && validTeacherReviewSubmissionCleanup(attemptId))
          || validTeacherDraftAttemptUpdate()
          || validTeacherReviewSubmissionTraineeSubmit(attemptId)
          || validCanonicalTeacherReviewSubmissionAttachDraft(attemptId)
          || validCanonicalTeacherReviewSubmissionBeginDraftRemoval(attemptId)
          || validCanonicalTeacherReviewSubmissionCompleteDraftRemoval(attemptId)
          || validCanonicalTeacherReviewSubmissionPromote(attemptId)
          || validCanonicalTeacherReviewSubmissionBeginUnsubmit(attemptId)
          || validCanonicalTeacherReviewSubmissionCompleteUnsubmit(attemptId)
          || validCanonicalTeacherReviewSubmissionDeletionFailure(attemptId)
          || validCanonicalTeacherReviewSubmissionCheckedReview()
          || validTeacherReviewResultSent()
          || validTeacherReviewSubmissionTeacherReview(attemptId)
          || validTeacherReviewSubmissionCleanup(attemptId)
        );
      allow delete: if isSignedIn()
        && !exists(userPath(request.auth.uid))
        && (
          resource.data.trainee_id == request.auth.uid
          || resource.data.teacher_id == request.auth.uid
        );
    }

    // Direct Messages v1. The Functions/Admin SDK owns directory writes and
    // account-erasure archival. Verified Teachers may list/get Teacher-role
    // directory rows for Faculties; Trainees cannot read the collection.
    // Clients own participant-scoped conversations, messages, read state,
    // and one-way block records.
    function chatConversationPath(conversationId) {
      return /databases/$(database)/documents/chat_conversations/$(conversationId);
    }
    function chatMessagePath(conversationId, messageId) {
      return /databases/$(database)/documents/chat_conversations/$(conversationId)/messages/$(messageId);
    }
    function chatBlockPath(blockerId, blockedId) {
      return /databases/$(database)/documents/chat_blocks/$(blockerId)/blocked_users/$(blockedId);
    }
    function isSupportedChatAccount(userId) {
      return isParticipantId(userId)
        && exists(userPath(userId))
        && get(userPath(userId)).data.role in ['Teacher', 'Trainee']
        && get(userPath(userId)).data.get('lifecycle_state', 'active')
          != 'deleting';
    }
    function otherChatParticipant(data, userId) {
      return data.participant_ids[0] == userId
        ? data.participant_ids[1]
        : data.participant_ids[0];
    }
    function isChatParticipant(data) {
      return isSignedIn()
        && data.participant_ids is list
        && data.participant_ids.size() == 2
        && request.auth.uid in data.participant_ids;
    }
    function isChatInboxParticipant(data) {
      return isSignedIn()
        && (
          data.participant_a == request.auth.uid
          || data.participant_b == request.auth.uid
        );
    }
    function validChatPair(data, conversationId) {
      return data.participant_ids is list
        && data.participant_ids.size() == 2
        && isParticipantId(data.participant_ids[0])
        && isParticipantId(data.participant_ids[1])
        && data.participant_ids[0] < data.participant_ids[1]
        && data.participant_a == data.participant_ids[0]
        && data.participant_b == data.participant_ids[1]
        && conversationId
          == data.participant_ids[0] + '__' + data.participant_ids[1]
        && isSupportedChatAccount(data.participant_ids[0])
        && isSupportedChatAccount(data.participant_ids[1]);
    }
    function chatPairIsUnblocked(firstId, secondId) {
      return !exists(chatBlockPath(firstId, secondId))
        && !exists(chatBlockPath(secondId, firstId));
    }
    function validChatSnapshot(snapshot, userId) {
      return snapshot is map
        && snapshot.keys().hasOnly(['id', 'display_name', 'role', 'avatar_url'])
        && snapshot.id == userId
        && snapshot.display_name == get(userPath(userId)).data.full_name
        && snapshot.role == get(userPath(userId)).data.role
        && snapshot.get('avatar_url', '')
          == get(userPath(userId)).data.get('profile_picture_url', '');
    }
    function validChatSnapshots(data) {
      return data.participant_snapshots is map
        && data.participant_snapshots.keys().hasOnly(data.participant_ids)
        && validChatSnapshot(
          data.participant_snapshots[data.participant_ids[0]],
          data.participant_ids[0]
        )
        && validChatSnapshot(
          data.participant_snapshots[data.participant_ids[1]],
          data.participant_ids[1]
        );
    }
    function validChatBody(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 2000
        && value.matches('.*[^[:space:]].*');
    }
    function validChatConversationKeys(data) {
      return data.keys().hasOnly([
          'participant_ids', 'participant_a', 'participant_b',
          'participant_snapshots', 'last_message_id',
          'last_message_body', 'last_message_sender_id', 'last_message_at',
          'unread_counts', 'read_at', 'status', 'created_at', 'updated_at',
          'schema_version', 'cleared_at'
        ]);
    }
    function validChatConversationCreate(data, conversationId) {
      let sender = request.auth.uid;
      let recipient = otherChatParticipant(data, sender);
      return isSignedIn()
        && validChatConversationKeys(data)
        && validChatPair(data, conversationId)
        && sender in data.participant_ids
        && chatPairIsUnblocked(sender, recipient)
        && validChatSnapshots(data)
        && data.status == 'active'
        && data.schema_version in [1, 2]
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.last_message_at == request.time
        && data.last_message_sender_id == sender
        && validChatBody(data.last_message_body)
        && data.unread_counts is map
        && data.unread_counts.keys().hasAll(data.participant_ids)
        && data.unread_counts.keys().hasOnly(data.participant_ids)
        && data.unread_counts[sender] == 0
        && data.unread_counts[recipient] == 1
        && data.get('cleared_at', {}).size() == 0
        && data.read_at is map
        && data.read_at.keys().hasAll(data.participant_ids)
        && data.read_at.keys().hasOnly(data.participant_ids)
        && data.read_at[sender] == request.time
        && data.read_at[recipient] == null
        && existsAfter(chatMessagePath(conversationId, data.last_message_id))
        && getAfter(chatMessagePath(conversationId, data.last_message_id)).data.sender_id == sender
        && getAfter(chatMessagePath(conversationId, data.last_message_id)).data.body == data.last_message_body;
    }
    function validChatSendUpdate(conversationId) {
      let before = resource.data;
      let after = request.resource.data;
      let sender = request.auth.uid;
      let recipient = otherChatParticipant(before, sender);
      let message = getAfter(chatMessagePath(conversationId, after.last_message_id)).data;
      return isChatParticipant(before)
        && before.status == 'active'
        && isSupportedChatAccount(before.participant_ids[0])
        && isSupportedChatAccount(before.participant_ids[1])
        && chatPairIsUnblocked(sender, recipient)
        && after.diff(before).affectedKeys().hasOnly([
          'last_message_id', 'last_message_body', 'last_message_sender_id',
          'last_message_at', 'unread_counts', 'updated_at'
        ])
        && after.participant_ids == before.participant_ids
        && after.participant_snapshots == before.participant_snapshots
        && after.status == before.status
        && after.created_at == before.created_at
        && after.schema_version == before.schema_version
        && after.last_message_sender_id == sender
        && after.last_message_at == request.time
        && after.updated_at == request.time
        && validChatBody(after.last_message_body)
        && after.unread_counts[sender] == 0
        && after.unread_counts[recipient]
          == before.unread_counts.get(recipient, 0) + 1
        && existsAfter(chatMessagePath(conversationId, after.last_message_id))
        && message.sender_id == sender
        && message.body == after.last_message_body
        && message.created_at == request.time;
    }
    function validChatReadUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let caller = request.auth.uid;
      let other = otherChatParticipant(before, caller);
      return isChatParticipant(before)
        && after.diff(before).affectedKeys().hasOnly(['unread_counts', 'read_at'])
        && after.unread_counts.keys().hasAll(before.participant_ids)
        && after.unread_counts.keys().hasOnly(before.participant_ids)
        && after.unread_counts[caller] == 0
        && after.unread_counts[other] == before.unread_counts[other]
        && after.read_at.keys().hasAll(before.participant_ids)
        && after.read_at.keys().hasOnly(before.participant_ids)
        && after.read_at[caller] == request.time
        && after.read_at[other] == before.read_at[other];
    }
    function validChatUnreadUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let caller = request.auth.uid;
      let other = otherChatParticipant(before, caller);
      return isChatParticipant(before)
        && after.diff(before).affectedKeys().hasOnly(['unread_counts'])
        && after.unread_counts.keys().hasAll(before.participant_ids)
        && after.unread_counts.keys().hasOnly(before.participant_ids)
        && after.unread_counts[caller] == 1
        && after.unread_counts[other] == before.unread_counts[other];
    }
    function validChatClearUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let caller = request.auth.uid;
      let other = otherChatParticipant(before, caller);
      let beforeCleared = before.get('cleared_at', {});
      return isChatParticipant(before)
        && after.diff(before).affectedKeys().hasOnly([
          'unread_counts', 'read_at', 'cleared_at'
        ])
        && after.unread_counts.keys().hasAll(before.participant_ids)
        && after.unread_counts.keys().hasOnly(before.participant_ids)
        && after.unread_counts[caller] == 0
        && after.unread_counts[other] == before.unread_counts[other]
        && after.read_at.keys().hasAll(before.participant_ids)
        && after.read_at.keys().hasOnly(before.participant_ids)
        && after.read_at[caller] == request.time
        && after.read_at[other] == before.read_at[other]
        && after.cleared_at is map
        && after.cleared_at.keys().hasOnly(before.participant_ids)
        && after.cleared_at[caller] == request.time
        && after.cleared_at.get(other, null) == beforeCleared.get(other, null);
    }
    function validLatestMessageSummaryUpdate(conversationId) {
      let before = resource.data;
      let after = request.resource.data;
      let message = getAfter(chatMessagePath(conversationId, before.last_message_id)).data;
      return isChatParticipant(before)
        && after.diff(before).affectedKeys().hasOnly(['last_message_body'])
        && message.sender_id == request.auth.uid
        && (
          (message.deleted_at == null && after.last_message_body == message.body)
          || (message.deleted_at == request.time
            && after.last_message_body == 'Message deleted')
        );
    }

    match /chat_user_directory/{userId} {
      allow write: if false;
      allow get, list: if isVerifiedTeacher()
        && resource.data.role == 'Teacher';
    }

    match /chat_search_rate_limits/{userId} {
      allow read, write: if false;
    }

    match /chat_blocks/{blockerId}/blocked_users/{blockedId} {
      allow get: if isSignedIn()
        && (request.auth.uid == blockerId || request.auth.uid == blockedId);
      allow list: if isSignedIn() && request.auth.uid == blockerId;
      allow create: if isSignedIn()
        && request.auth.uid == blockerId
        && blockerId != blockedId
        && isSupportedChatAccount(blockedId)
        && request.resource.data.keys().hasAll([
          'blocker_id', 'blocked_id', 'created_at'
        ])
        && request.resource.data.keys().hasOnly([
          'blocker_id', 'blocked_id', 'created_at'
        ])
        && request.resource.data.blocker_id == blockerId
        && request.resource.data.blocked_id == blockedId
        && request.resource.data.created_at == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == blockerId;
    }

    match /chat_conversations/{conversationId} {
      // The first-send transaction must confirm that its deterministic
      // conversation document does not exist yet. Missing documents expose no
      // conversation data; existing documents remain participant-only.
      allow get: if isSignedIn()
        && (resource == null || isChatParticipant(resource.data));
      allow list: if isChatInboxParticipant(resource.data);
      allow create: if validChatConversationCreate(
        request.resource.data,
        conversationId
      );
      allow update: if validChatSendUpdate(conversationId)
        || validChatReadUpdate()
        || validChatUnreadUpdate()
        || validChatClearUpdate()
        || validLatestMessageSummaryUpdate(conversationId);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if exists(chatConversationPath(conversationId))
          && isChatParticipant(get(chatConversationPath(conversationId)).data);
        allow create: if isSignedIn()
          && request.resource.data.keys().hasAll([
            'sender_id', 'body', 'created_at', 'edited_at', 'deleted_at'
          ])
          && request.resource.data.keys().hasOnly([
            'sender_id', 'body', 'created_at', 'edited_at', 'deleted_at',
            'idempotency_key'
          ])
          && request.resource.data.sender_id == request.auth.uid
          && validChatBody(request.resource.data.body)
          && request.resource.data.created_at == request.time
          && request.resource.data.edited_at == null
          && request.resource.data.deleted_at == null
          && (
            !request.resource.data.keys().hasAny(['idempotency_key'])
            || request.resource.data.idempotency_key is string
              && request.resource.data.idempotency_key.size() > 0
              && request.resource.data.idempotency_key.size() <= 256
          )
          && existsAfter(chatConversationPath(conversationId))
          && getAfter(chatConversationPath(conversationId)).data.status == 'active'
          && isChatParticipant(getAfter(chatConversationPath(conversationId)).data)
          && getAfter(chatConversationPath(conversationId)).data.last_message_id == messageId
          && chatPairIsUnblocked(
            request.auth.uid,
            otherChatParticipant(
              getAfter(chatConversationPath(conversationId)).data,
              request.auth.uid
            )
          );
        allow update: if exists(chatConversationPath(conversationId))
          && isChatParticipant(get(chatConversationPath(conversationId)).data)
          && resource.data.sender_id == request.auth.uid
          && request.resource.data.sender_id == resource.data.sender_id
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.keys().hasOnly([
            'sender_id', 'body', 'created_at', 'edited_at', 'deleted_at',
            'legacy_coaching', 'idempotency_key'
          ])
          && (
            (
              resource.data.deleted_at == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['body', 'edited_at'])
              && validChatBody(request.resource.data.body)
              && request.resource.data.edited_at == request.time
              && request.resource.data.deleted_at == null
            )
            || (
              resource.data.deleted_at == null
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['body', 'edited_at', 'deleted_at'])
              && request.resource.data.body == null
              && request.resource.data.edited_at == null
              && request.resource.data.deleted_at == request.time
            )
          );
        allow delete: if false;
      }
    }

    // Phase 3A asynchronous teacher recommendations. They intentionally carry
    // no session or assessment data, and progress sharing is not consulted.
    // Group-backed notes are listed with teacher_id + trainee_id + group_id.
    // Legacy-link notes are listed with teacher_id + trainee_id +
    // authorization_source == 'legacy_link'. Firestore cannot prove
    // "group_id is absent", so Teacher+Trainee without a discriminant is denied.
    function isGroupBackedCoachingNote(data) {
      return data.keys().hasAll(['group_id'])
        && isParticipantId(data.group_id);
    }
    function isLegacyLinkCoachingSource(data) {
      return data.keys().hasAll(['authorization_source'])
        && data.authorization_source == 'legacy_link';
    }
    function isHistoricalLegacyCoachingNote(data) {
      return !data.keys().hasAny(['group_id'])
        && !data.keys().hasAny(['authorization_source']);
    }
    function approvedClassroomCoaching(data) {
      return isSignedIn()
        && data.teacher_id == request.auth.uid
        && hasClassroomAuthorization(data.group_id, data.trainee_id);
    }
    function coachingMovementNames() {
      return ['Normal Grip', "Bartender's Grip", 'Reverse Grip', 'Claw Grip',
        'Hand Stall', 'One Finger Stall', 'Forearm Stall', 'Elbow Stall',
        'Reverse Forearm Stall', 'Shoulder Stall', 'Double Hand Stall',
        'Bottle in a tin'];
    }
    function isOfficialElixrMovementName(name) {
      return name is string && name in coachingMovementNames();
    }
    function officialMovementIdForName(name) {
      return name == 'Normal Grip' ? 'official_normal_grip'
        : name == "Bartender's Grip" ? 'official_bartenders_grip'
        : name == 'Reverse Grip' ? 'official_reverse_grip'
        : name == 'Claw Grip' ? 'official_claw_grip'
        : name == 'Hand Stall' ? 'official_hand_stall'
        : name == 'One Finger Stall' ? 'official_one_finger_stall'
        : name == 'Forearm Stall' ? 'official_forearm_stall'
        : name == 'Elbow Stall' ? 'official_elbow_stall'
        : name == 'Reverse Forearm Stall' ? 'official_reverse_forearm_stall'
        : name == 'Shoulder Stall' ? 'official_shoulder_stall'
        : name == 'Double Hand Stall' ? 'official_double_hand_stall'
        : name == 'Bottle in a tin' ? 'official_bottle_in_a_tin'
        : '';
    }
    function officialRevisionIdForName(name) {
      let movementId = officialMovementIdForName(name);
      return movementId == '' ? '' : movementId + '_v1';
    }
    function approvedCoachingLink(teacherId, traineeId) {
      return exists(teacherStudentLinkPath(teacherId, traineeId))
        && get(teacherStudentLinkPath(teacherId, traineeId)).data.teacher_id == teacherId
        && get(teacherStudentLinkPath(teacherId, traineeId)).data.trainee_id == traineeId
        && get(teacherStudentLinkPath(teacherId, traineeId)).data.status == 'approved';
    }
    function isErasingOwnCoaching(data) {
      return isSignedIn() && (data.teacher_id == request.auth.uid || data.trainee_id == request.auth.uid)
        && !exists(userPath(request.auth.uid));
    }
    function isCoachingAuthor(data) {
      return isSignedIn() && data.teacher_id == request.auth.uid
        && (
          (isGroupBackedCoachingNote(data) && approvedClassroomCoaching(data))
          || (!data.keys().hasAny(['group_id'])
            && (isLegacyLinkCoachingSource(data)
              || isHistoricalLegacyCoachingNote(data))
            && approvedCoachingLink(data.teacher_id, data.trainee_id))
        );
    }
    match /teacher_coaching_notes/{noteId} {
      allow get: if isSignedIn() && resource.data.trainee_id == request.auth.uid;
      allow get: if isSignedIn() && isCoachingAuthor(resource.data);
      // Trainee receive: trainee_id == auth, orderBy created_at/__name__.
      allow list: if isSignedIn() && resource.data.trainee_id == request.auth.uid;
      // Group-backed Teacher history: teacher_id + trainee_id + group_id.
      allow list: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid
        && isGroupBackedCoachingNote(resource.data)
        && approvedClassroomCoaching(resource.data);
      // Legacy-link Teacher history: teacher_id + trainee_id + authorization_source.
      allow list: if isSignedIn()
        && resource.data.teacher_id == request.auth.uid
        && isLegacyLinkCoachingSource(resource.data)
        && approvedCoachingLink(resource.data.teacher_id, resource.data.trainee_id);
      allow list: if isErasingOwnCoaching(resource.data);
      // Legacy notes remain available for audit/migration but are immutable.
      allow create, update: if false;
      allow delete: if isErasingOwnCoaching(resource.data);
    }
  }
}
