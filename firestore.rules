            'status', 'review_feedback', 'grade_score', 'grade_max_score',
            'checked_at', 'review_updated_at', 'review_revision',
            'result_sent_revision', 'result_sent_at', 'result_message_id',
            'review_verdict', 'reviewed_at', 'video_expires_at'
          ]
        );
    }
    function validTeacherReviewResultSent() {
      let after = request.resource.data;
      return resource.data.teacher_id == request.auth.uid
        && resource.data.attempt_kind == 'teacher_review_submission'
        && resource.data.status == 'checked'
        && after.status == 'checked'
        && assignmentAttemptIdentityUnchanged()
        && assignmentAttemptVideoIdentityUnchanged()
        && after.keys().hasOnly(teacherReviewSubmissionCheckedKeys())
        && after.grade_score == resource.data.grade_score
        && after.grade_max_score == resource.data.grade_max_score
        && after.checked_at == resource.data.checked_at
        && after.review_updated_at == resource.data.review_updated_at
        && after.review_revision == resource.data.review_revision
        && !resource.data.keys().hasAny([
