<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The bundled Python sidecar owns the webcam; it runs inside this
	     sandbox (signed with app-sandbox + inherit), so camera access is
	     granted here and attributed to ELIXR for the TCC prompt. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Supabase HTTPS/Realtime, and the loopback FastAPI/WebSocket client. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Loopback listeners: the sidecar's 127.0.0.1 port, the free-port
	     probe, and the Google OAuth / email-confirmation callbacks. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- file_selector / image_picker open panels and save panels. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
