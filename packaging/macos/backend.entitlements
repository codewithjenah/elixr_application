<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The frozen backend is a child of the sandboxed ELIXR app. A sandboxed
	     helper must carry exactly app-sandbox + inherit so it runs inside the
	     parent's sandbox (camera, loopback server, network) instead of
	     receiving its own. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
